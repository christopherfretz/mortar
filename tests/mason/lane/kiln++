#!/bin/bash
# The Mason lane's compiler (tests/mason/README.md "libc++"): kiln's
# libc++ runner calls this as its --compiler. Compiles go to kiln++
# unchanged. Links, except in mode `dyn` and the `dyn-*` modes, are made
# static (libc++ and glibc), drop the runner's -Bstatic/-Bdynamic/
# --as-needed, and use the `ld` of $MASON_LANE/ld/$MASON_LD (GNU ld, lld,
# mold or mortar). A `dyn-<linker>` mode keeps kiln's dynamic line as the
# runner wrote it (static libc++, dynamic glibc; the driver's default PIE)
# and only names the lane's `ld` (-B).
# With MASON_LIB_FROM/MASON_LIB_TO, -L$MASON_LIB_FROM becomes -L$MASON_LIB_TO.
# $MASON_CFLAGS (words) is added to every command (`--cflags`, e.g. -O2).
: "${MASON_KILN:?}" "${MASON_MODE:?}"
link=1
for a in "$@"; do
  case "$a" in
    -c|-fsyntax-only|-E|-S|--precompile|-M|-MM|--version|-dumpversion|-dumpmachine|-print-*|-###) link=0;;
  esac
done
[ $# = 0 ] && link=0
read -r -a cflags <<< "${MASON_CFLAGS:-}"
if [ $link = 0 ] || [ "$MASON_MODE" = dyn ]; then exec "$MASON_KILN" "$@" "${cflags[@]}"; fi
ld="${MASON_LANE:?}/ld/${MASON_LD:?}"
case "$MASON_MODE" in
  dyn-*)
    [ -x "$ld/ld" ] || { echo "kiln++ (Mason lane): $ld/ld is not executable" >&2; exit 125; }
    exec "$MASON_KILN" "$@" "${cflags[@]}" -B"$ld";;
esac
args=()
for a in "$@"; do
  case "$a" in
    -Wl,--as-needed|-Wl,-Bstatic|-Wl,-Bdynamic) ;;
    -L"${MASON_LIB_FROM:-/nonexistent}") args+=("-L$MASON_LIB_TO");;
    *) args+=("$a");;
  esac
done
# The driver skips a -B directory whose `ld` is not executable and links
# with the system's: a mode would then silently be GNU ld's.
[ -x "$ld/ld" ] || { echo "kiln++ (Mason lane): $ld/ld is not executable" >&2; exit 125; }
exec "$MASON_KILN" "${args[@]}" "${cflags[@]}" -static -B"$ld"
