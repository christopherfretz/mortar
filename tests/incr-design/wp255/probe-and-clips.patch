+/// WP-255 throwaway probe (never committed): counts of Column reads by
+/// (phase, column type, row, kind) while `ON`.
+#[cfg(feature = "wp255probe")]
+pub mod probe {
+    use std::collections::HashMap;
+    use std::sync::Mutex;
+    use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+    pub static ON: AtomicBool = AtomicBool::new(false);
+    pub static PHASE: AtomicU32 = AtomicU32::new(0);
+    type Log = HashMap<(u32, &'static str, u32, u8), u64>;
+    pub static LOG: Mutex<Option<Log>> = Mutex::new(None);
+    pub static NAMES: Mutex<Vec<String>> = Mutex::new(Vec::new());
+    #[inline]
+    pub fn hit(t: &'static str, id: u32, kind: u8, n: u64) {
+        if !ON.load(Ordering::Relaxed) {
+            return;
+        }
+        let ph = PHASE.load(Ordering::Relaxed);
+        let mut g = LOG.lock().unwrap();
+        *g.get_or_insert_with(HashMap::new).entry((ph, t, id, kind)).or_insert(0) += n;
+    }
+    pub fn step(name: &str) {
+        if !ON.load(Ordering::Relaxed) {
+            return;
+        }
+        NAMES.lock().unwrap().push(name.to_owned());
+        PHASE.fetch_add(1, Ordering::Relaxed);
+    }
+    pub fn start() {
+        *LOG.lock().unwrap() = Some(HashMap::new());
+        NAMES.lock().unwrap().clear();
+        PHASE.store(0, Ordering::Relaxed);
+        ON.store(true, Ordering::Relaxed);
+    }
+    pub fn stop() -> (Log, Vec<String>) {
+        ON.store(false, Ordering::Relaxed);
+        (LOG.lock().unwrap().take().unwrap_or_default(), NAMES.lock().unwrap().clone())
+    }
+}
