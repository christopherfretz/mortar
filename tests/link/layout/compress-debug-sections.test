# `--compress-debug-sections` (a `partial` row of docs/status/options.md:
# "`=zlib`, `=zlib-gnu`, `=zlib-gabi`, `=zstd` refused (image.md: debug
# sections are written uncompressed; mortar writes =none only)").
# - The part that works: `=none`, the same bytes as no option (debug
#   sections uncompressed, no SHF_COMPRESSED), on every linker.
# - The part that does not: every compressing value is refused by name,
#   `unsupported option value`, with the row's reason as the note.
# - The references compress under `=zlib` (SHF_COMPRESSED) and their
#   links are made: the verifier does not judge a compressed section's
#   contents by R6 and counts it "not judged: compressed" (plumb.md §5.6;
#   WP-131 V4, before which R6 read the deflated bytes raw and reported
#   GNU ld's and lld's correct outputs). From mortar a compressed section
#   is an S1 finding.
#@ spec: cli.md "§3.8"

cc -g -O1 prog.c -o prog.o
link gcc -static prog.o -o plain
link gcc -static prog.o -Wl,--compress-debug-sections=none -o none
run none
  stdout: hello 42
check cmp none plain
  has: ^identical$
check readelf -SW plain
  has: .debug_info 
  not: .debug_info * C 
link(bfd,lld,mold) gcc -static prog.o -Wl,--compress-debug-sections=zlib -o zlib
run(bfd,lld,mold) zlib
  stdout: hello 42
check(bfd,lld,mold) readelf -SW zlib
  has: .debug_info * C 
link(mortar) gcc -static prog.o -Wl,--compress-debug-sections=zlib -o zlib
  exit: fail
  diag: unsupported option value: --compress-debug-sections=zlib
  diag: debug sections are written uncompressed; mortar writes =none only
link(mortar) gcc -static prog.o -Wl,--compress-debug-sections=zlib-gnu -o zlib-gnu
  exit: fail
  diag: unsupported option value: --compress-debug-sections=zlib-gnu
link(mortar) gcc -static prog.o -Wl,--compress-debug-sections=zlib-gabi -o zlib-gabi
  exit: fail
  diag: unsupported option value: --compress-debug-sections=zlib-gabi
link(mortar) gcc -static prog.o -Wl,--compress-debug-sections=zstd -o zstd
  exit: fail
  diag: unsupported option value: --compress-debug-sections=zstd

#--- prog.c
#include <stdio.h>
static const char msg[] = "hello";
int value = 42;
int main(void) { printf("%s %d\n", msg, value); return 0; }
