# AArch64's large code model (GCC `-mcmodel=large`; WP-084's record):
# no section flag and no large sections. Addresses come from literal
# pools: `R_AARCH64_ABS64` words in `.text.startup` loaded by
# `ADR_PREL_PG_HI21` + `LDST64_ABS_LO12_NC`, and calls stay `CALL26`.
# GCC 14 refuses `-mcmodel=large` with `-fPIC`/`-fPIE` ("sorry,
# unimplemented"), so the model exists in static and `-no-pie` links only.
#@ spec: a64.md "2. Census"
#@ arch: aarch64

cc -O2 -mcmodel=large -fno-pic -fno-common lg.c -o lg.o
cc -O2 -fno-pic ext.c -o ext.o
link gcc -static lg.o ext.o -o lg-static
link gcc -no-pie lg.o ext.o -o lg
run lg-static
  stdout: 5 1 2 6 3 0 4 b 42
run lg
  stdout: 5 1 2 6 3 0 4 b 42

#--- lg.c
#include <stdio.h>
#ifndef BIG
#define BIG (1<<20)
#endif
static char lb[BIG];                 /* .lbss */
char ld_[BIG] = {1};                 /* .ldata */
const char lr[1<<20] = {2};          /* .lrodata */
char lc[BIG];                        /* LCOMMON with -fcommon */
int small_d = 3; int small_b; const int small_r = 4;
extern int ext_fn(int);
static const char *strs[] = {"a", "b"};
int main(void){ lb[BIG-1]=5; lc[BIG-1]=6; printf("%d %d %d %d %d %d %d %s %d\n", lb[BIG-1], ld_[0], lr[0], lc[BIG-1], small_d, small_b, small_r, strs[1], ext_fn(1)); return 0; }
#--- ext.c
int ext_fn(int x) { return x + 41; }
