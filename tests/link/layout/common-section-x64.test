# x86-64: `COMMON` and `LARGE_COMMON` with and without
# `SHF_X86_64_LARGE` (layout.md L-44a, L-36; measured in
# spec/landed/layout/WP-203.md). The flag wins over the name in mortar
# (L-36): `COMMON`, `LARGE_COMMON` and `LARGE_COMMON.z` with it go to
# `.lbss`, which keeps the flag; GNU ld puts `LARGE_COMMON` there by name
# (its script's `*(LARGE_COMMON)`, the flag or not) and leaves
# `LARGE_COMMON.z` an orphan; lld makes both orphans; both put a large
# `COMMON` in `.bss`, which takes the flag. Without the flag mortar
# follows lld: `LARGE_COMMON` is an orphan (L-44's uniform rule; no
# producer writes one). Every program runs alike, on every linker
# (the verifier places an input `COMMON` by its file's row, WP-210).
#@ spec: layout.md "L-44a"
#@ spec: layout.md "L-36a"
#@ arch: x86_64

cc -O1 mlarge.c -o mlarge.o
cc -O1 mla.c -o mla.o
as vlarge.s -o vlarge.o
as vlnf.s -o vlnf.o
as vcoml.s -o vcoml.o

link gcc -static mlarge.o vlarge.o -o large
run large
  stdout: 6 8
link gcc -pie mlarge.o vlarge.o -o large-pie
run large-pie
  stdout: 6 8
check(bfd,mortar) readelf -SW large
  has: .lbss NOBITS * WAl
  not: LARGE_COMMON NOBITS
check(lld) readelf -SW large
  has: LARGE_COMMON NOBITS * WAl
check(mortar) readelf -SW large-pie
  has: .lbss NOBITS * WAl
  not: LARGE_COMMON NOBITS

link gcc -static mlarge.o vlnf.o -o lnf
run lnf
  stdout: 6 8
check(lld,mortar) readelf -SW lnf
  has: LARGE_COMMON NOBITS * WA
check(bfd) readelf -SW lnf
  not: LARGE_COMMON NOBITS
  has: .lbss NOBITS
  has: LARGE_COMMON.z NOBITS * WAl
check(mortar) readelf -SW lnf
  has: .lbss NOBITS * WAl
  not: LARGE_COMMON.z

link gcc -static mla.o vcoml.o -o coml
run coml
  stdout: 8
link gcc -static mlarge.o vcoml.o -o coml-use
run coml-use
  stdout: 6 8
check(mortar) readelf -SW coml-use
  has: .lbss NOBITS * WAl
  not: COMMON NOBITS
check(bfd,lld,mortar) readelf -SW coml
  not: COMMON NOBITS
check(bfd,lld) readelf -SW coml
  has: .bss NOBITS * WAl
check(mortar) readelf -SW coml
  has: .lbss NOBITS * WAl
  not: .bss NOBITS * WAl

#--- mlarge.c
#include <stdio.h>
extern long lc[2], la[2];
int main(void) { lc[1] = 6; la[1] = 8; printf("%ld %ld\n", lc[1], la[1]); return 0; }
#--- mla.c
#include <stdio.h>
extern long la[2];
int main(void) { la[1] = 8; printf("%ld\n", la[1]); return 0; }
#--- vlarge.s
	.section LARGE_COMMON,"awl",@nobits
	.p2align 3
	.globl lc
lc:	.zero 16
	.section LARGE_COMMON.z,"aw",@nobits
	.p2align 3
	.globl la
la:	.zero 16
#--- vlnf.s
	.section LARGE_COMMON,"aw",@nobits
	.p2align 3
	.globl lc
lc:	.zero 16
	.section LARGE_COMMON.z,"awl",@nobits
	.p2align 3
	.globl la
la:	.zero 16
#--- vcoml.s
	.section COMMON,"awl",@nobits
	.p2align 3
	.globl lc
lc:	.zero 16
	.section LARGE_COMMON.z,"aw",@nobits
	.p2align 3
	.globl la
la:	.zero 16
