# A symbol defined in `.note.gnu.property` has no place (WP-136,
# resolve.md §10.1 P-1): the linker consumes the input notes and writes
# one note of its own (layout.md L-34), so no input byte of the section
# is in the output. A reference to such a symbol is refused by name, as
# a reference to a symbol of a discarded section, naming the symbol, the
# referring section and file, and the defining section and file. Before
# WP-136 mortar wrote 0 for the word of `ref.o` and exited 0 (WP-136's
# second mislink); it refused the local's word by "offset is outside the
# section".
#
# GNU ld and lld refuse the global's reference the same way; mold says
# the global is undefined, but links the local's word (the note's
# address, which lies in its own merged note), so the local's link is
# checked on GNU ld, lld and mortar (the assembler writes the local's
# word against the section symbol, so the section is the name). A debug word that names the global
# gets mortar's tombstone (image.md I-124; GNU ld writes 0). With no
# reference the symbol is never an error and is not in `.symtab` (lld
# keeps it as an undefined symbol). A shared object omits it from
# `.dynsym` too (D-110; GNU ld exports it as an absolute symbol whose
# value is its offset in the note, lld as undefined, mold not at all),
# which is not checked here: the verifier's P-D19 still expects it there
# (its side is WP-143's).
#@ spec: resolve.md §10.1
#@ spec: image.md "I-124"

cc -O1 main.c -o main.o
as prop-%{arch}.s -o prop.o
as propl-%{arch}.s -o propl.o
as ref.s -o ref.o
as dbg.s -o dbg.o
link gcc -static main.o prop.o ref.o -o refd
  exit: fail
  diag(mortar): relocation refers to a symbol in a discarded section: gprop
  diag(mortar): defined in prop.o:(.note.gnu.property)
  diag(mortar): referenced by ref.o:(.data+0x0)
link(bfd,lld,mortar) gcc -static main.o propl.o -o local
  exit: fail
  diag(mortar): relocation refers to a symbol in a discarded section: .note.gnu.property
  diag(mortar): defined in propl.o:(.note.gnu.property)
link gcc -static main.o prop.o -o prog
run prog
  exit: 42
check(bfd,mold,mortar) readelf -sW prog
  not: gprop
link(mortar) gcc -static main.o prop.o dbg.o -o dbg
check(mortar,aarch64,x86_64) readelf -x .debug_info dbg
  has: ffffffff ffffffff

#--- main.c
int main(void) { return 42; }
#--- ref.s
	.data
	.dc.a	gprop
	.section .note.GNU-stack,"",%progbits
#--- dbg.s
	.section .debug_info,"",%progbits
	.dc.a	gprop
	.section .note.GNU-stack,"",%progbits
#--- prop-aarch64.s
	.section .note.gnu.property,"a",%note
	.p2align 3
	.globl	gprop
gprop:	.long	4,16,5
	.asciz	"GNU"
	.long	0xc0000000,4,3,0
	.section .note.GNU-stack,"",%progbits
#--- prop-x86_64.s
	.section .note.gnu.property,"a",%note
	.p2align 3
	.globl	gprop
gprop:	.long	4,16,5
	.asciz	"GNU"
	.long	0xc0000002,4,3,0
	.section .note.GNU-stack,"",%progbits
#--- prop-i386.s
	.section .note.gnu.property,"a",%note
	.p2align 2
	.globl	gprop
gprop:	.long	4,12,5
	.asciz	"GNU"
	.long	0xc0000002,4,3
	.section .note.GNU-stack,"",%progbits
#--- propl-aarch64.s
	.section .note.gnu.property,"a",%note
	.p2align 3
lprop:	.long	4,16,5
	.asciz	"GNU"
	.long	0xc0000000,4,3,0
	.data
	.dc.a	lprop
	.section .note.GNU-stack,"",%progbits
#--- propl-x86_64.s
	.section .note.gnu.property,"a",%note
	.p2align 3
lprop:	.long	4,16,5
	.asciz	"GNU"
	.long	0xc0000002,4,3,0
	.data
	.dc.a	lprop
	.section .note.GNU-stack,"",%progbits
#--- propl-i386.s
	.section .note.gnu.property,"a",%note
	.p2align 2
lprop:	.long	4,12,5
	.asciz	"GNU"
	.long	0xc0000002,4,3
	.data
	.dc.a	lprop
	.section .note.GNU-stack,"",%progbits
