# A global defined in a section the link drops by a named rule other
# than COMDAT has no place (WP-136, resolve.md §10.1 P-1): an
# `SHF_EXCLUDE` section (`gex`), `.note.GNU-stack` (`gstk`) and an input
# `.note.gnu.build-id` (`gbid`; the linker writes its own) are dropped
# (resolve.md §10). A reference to such a global is refused by name, as
# a reference to a symbol of a discarded section; before WP-136 each
# link stopped with mortar's internal error ("missing term: live
# target"). With no reference the globals are never an error and are in
# neither `.symtab` nor the `.dynsym` of a shared object that would
# export them (mortar makes shared objects on AArch64 only).
#
# The references disagree on each kind, so each link is checked where
# they refuse it: GNU ld calls `gex` undefined and mold links it in its
# own `.foo`; GNU ld links `gstk` (at the end of `.text`) and mold calls
# it undefined; mold calls `gbid` undefined. GNU ld exports each as an
# absolute symbol (the offset in its section), lld as undefined: the
# shared object is checked on mortar only, and without `gstk`: the
# verifier's P-D19 still expects an unreferenced export of
# `.note.GNU-stack` in `.dynsym` (its side is WP-143's). lld keeps each unreferenced
# global in `.symtab` as an undefined symbol.
#@ spec: resolve.md §10.1

cc -O1 main.c -o main.o
as defs.s -o defs.o
as stk.s -o stk.o
as rex.s -o rex.o
as rstk.s -o rstk.o
as rbid.s -o rbid.o
link(bfd,lld,mortar) gcc -static main.o defs.o rex.o -o ex
  exit: fail
  diag(mortar): relocation refers to a symbol in a discarded section: gex
  diag(mortar): defined in defs.o:(.foo)
  diag(mortar): referenced by rex.o:(.data+0x0)
link(lld,mold,mortar) gcc -static main.o stk.o rstk.o -o stk
  exit: fail
  diag(mortar): relocation refers to a symbol in a discarded section: gstk
  diag(mortar): defined in stk.o:(.note.GNU-stack)
link gcc -static main.o defs.o rbid.o -o bid
  exit: fail
  diag(mortar): relocation refers to a symbol in a discarded section: gbid
  diag(mortar): defined in defs.o:(.note.gnu.build-id)
link gcc -static main.o defs.o stk.o -o prog
run prog
  exit: 42
check(bfd,mortar) readelf -sW prog
  not: gex
  not: gbid
check(mold,mortar) readelf -sW prog
  not: gstk
link(aarch64,mortar) ld -shared defs.o -o libdefs.so
check(aarch64,mortar) readelf -sW --dyn-syms libdefs.so
  not: gex
  not: gbid

#--- main.c
int main(void) { return 42; }
#--- defs.s
	.section .foo,"ae",%progbits
	.globl	gex
gex:	.long	1,2
	.section .note.gnu.build-id,"a",%note
	.p2align 2
	.globl	gbid
gbid:	.long	4,8,3
	.asciz	"GNU"
	.long	1,2
	.section .note.GNU-stack,"",%progbits
#--- stk.s
	.section .note.GNU-stack,"",%progbits
	.globl	gstk
gstk:
#--- rex.s
	.data
	.dc.a	gex
	.section .note.GNU-stack,"",%progbits
#--- rstk.s
	.data
	.dc.a	gstk
	.section .note.GNU-stack,"",%progbits
#--- rbid.s
	.data
	.dc.a	gbid
	.section .note.GNU-stack,"",%progbits
