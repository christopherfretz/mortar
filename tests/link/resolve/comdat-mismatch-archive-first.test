# comdat-mismatch-weak-archive-extract.test's shape with the archive
# before the dropped copy (WP-200; resolve.md §4.1, §6.2): wu.o's strong
# reference reaches the archive before wb.o is read, first(hx) is the
# member, which is extracted in the closure's first iteration: no
# feedback from the dropped copy is needed, and mortar linked these
# before WP-200 too. arc: 7 + 7 + 1; copy: the member also has a copy
# of g (returning 3), the lowest live one, so it is kept (§6.1) and
# wa.o's and wb.o's are dropped: 7 + 7 + 3; grp: the dropped copy in a
# member after the one defining hx, in a group. GNU ld and lld agree;
# mold refuses arc and copy (undefined symbol: hx), as if it did not
# extract for a key a dropped copy defines.
#@ spec: resolve.md §4.1
#@ spec: resolve.md §6.2
#@ arch: aarch64 x86_64 i386

as wa.S -o wa.o
as wb.S -o wb.o
as hxg.S -o hxg.o
cc -O1 hx.c -o hx.o
cc -O1 wu.c -o wu.o
ar rcs libhx.a hx.o
ar rcs libhxg.a hxg.o
ar rcs libwb.a wb.o

link(mold) gcc -static -no-pie wu.o wa.o libhx.a wb.o -o arc
  exit: fail
  diag(mold): undefined symbol: hx
link(bfd,lld,mortar) gcc -static -no-pie wu.o wa.o libhx.a wb.o -o arc
run(bfd,lld,mortar) arc
  exit: 15
link(mold) gcc -static -no-pie wu.o libhxg.a wa.o wb.o -o copy
  exit: fail
  diag(mold): undefined symbol: hx
link(bfd,lld,mortar) gcc -static -no-pie wu.o libhxg.a wa.o wb.o -o copy
run(bfd,lld,mortar) copy
  exit: 17
link gcc -static -no-pie wu.o wa.o -Wl,--start-group libhx.a libwb.a -Wl,--end-group -o grp
run grp
  exit: 15

#--- wa.S
	.section .note.GNU-stack,"",%progbits
	.section .text.g,"axG",%progbits,g,comdat
	.weak g
	.type g,%function
g:
#if defined(__aarch64__)
	mov w0, #1
#else
	movl $1, %eax
#endif
	ret
#--- wb.S
	.section .text.g,"axG",%progbits,g,comdat
	.weak g
	.type g,%function
g:
#if defined(__aarch64__)
	mov w0, #2
#else
	movl $2, %eax
#endif
	ret
	.weak hx
	.type hx,%function
hx:
#if defined(__aarch64__)
	mov w0, #40
#else
	movl $40, %eax
#endif
	ret
	.text
	.globl Y
	.type Y,%function
Y:
#if defined(__aarch64__)
	stp x29, x30, [sp, -16]!
	bl hx
	ldp x29, x30, [sp], 16
#elif defined(__x86_64__)
	subq $8, %rsp
	call hx
	addq $8, %rsp
#else
	call hx
#endif
	ret
	.section .note.GNU-stack,"",%progbits
#--- hxg.S
	.section .text.g,"axG",%progbits,g,comdat
	.weak g
	.type g,%function
g:
#if defined(__aarch64__)
	mov w0, #3
#else
	movl $3, %eax
#endif
	ret
	.text
	.globl hx
	.type hx,%function
hx:
#if defined(__aarch64__)
	mov w0, #7
#else
	movl $7, %eax
#endif
	ret
	.section .note.GNU-stack,"",%progbits
#--- hx.c
int hx(void) { return 7; }
#--- wu.c
int Y(void);
int g(void);
int hx(void);
int main(void) { return Y() + hx() + g(); }
