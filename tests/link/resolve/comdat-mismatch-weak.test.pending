# PENDING (WP-176): no reference passes: the verifier finds the references' outputs wrong (R5 "refers to section '.text.g'/'.data.g', which is not in the output": the undefined-weak value of a reference through a demoted mention), which is right; the verifier package that follows WP-176 records it as a reference anomaly (an anomaly(bfd,lld) directive) and renames this file to .test.
# A WEAK definition only a dropped copy of a COMDAT group has (WP-176):
# wa.o's and wb.o's copies of group g define g (weak, as C++ writes
# every vague-linkage symbol), and wb.o's also defines a WEAK hx, which
# wb.o's Y calls. mortar keeps the copy of the lowest live FileId, wa.o's
# (resolve.md §6.1); wb.o's hx is then a demoted mention (§6.2) whose key
# nothing live defines. The reference through it is comdat-mismatch
# (§6.3 case (b)) whatever the mention's binding: wb.o HAD a definition,
# so its call is not a weak reference. GNU ld and lld take it as one and
# write the undefined-weak call: on AArch64 a branch to the next
# instruction (Y returns what w0 held, main's argc, 1: the exit status is
# 1 + g's 1), on x86-64 and i386 a call to address 0 (SIGSEGV). mold refuses it ("hx refers to a
# discarded COMDAT section probably due to an ODR violation").
# With wb.o first its copy is kept by all four, hx is defined: 42.
# A reference only from a section --gc-sections collects is no error
# (§5.1), as for an undefined symbol.
#@ spec: resolve.md §6.3
#@ spec: resolve.md §6.2
#@ arch: aarch64 x86_64 i386

cc -O1 wm.c -o wm.o
cc -O1 wm2.c -o wm2.o
as wa.S -o wa.o
as wb.S -o wb.o
as wbg.S -o wbg.o

link(bfd,lld) gcc -static -no-pie wm.o wa.o wb.o -o prog
run(bfd,lld,aarch64) prog
  exit: 2
run(bfd,lld,x86_64,i386) prog
  exit: signal 11
link(mold,mortar) gcc -static -no-pie wm.o wa.o wb.o -o prog
  exit: fail
  diag(mold): hx refers to a discarded COMDAT section probably due to an ODR violation
  diag(mortar): symbol hx is defined only in a discarded copy of COMDAT group g
  diag(mortar): >>> referenced by wb.o:(.text+0x

link gcc -static -no-pie wm.o wb.o wa.o -o kept
run kept
  exit: 42

link gcc -static -no-pie -Wl,--gc-sections wm2.o wa.o wbg.o -o gc
run gc
  exit: 1

#--- wm.c
int Y(void);
int g(void);
int main(void) { return Y() + g(); }
#--- wm2.c
int g(void);
int main(void) { return g(); }
#--- wa.S
	.section .note.GNU-stack,"",%progbits
	.section .text.g,"axG",%progbits,g,comdat
	.weak g
	.type g,%function
g:
#if defined(__aarch64__)
	mov w0, #1
#else
	movl $1, %eax
#endif
	ret
#--- wb.S
	.section .text.g,"axG",%progbits,g,comdat
	.weak g
	.type g,%function
g:
#if defined(__aarch64__)
	mov w0, #2
#else
	movl $2, %eax
#endif
	ret
	.weak hx
	.type hx,%function
hx:
#if defined(__aarch64__)
	mov w0, #40
#else
	movl $40, %eax
#endif
	ret
	.text
	.globl Y
	.type Y,%function
Y:
#if defined(__aarch64__)
	stp x29, x30, [sp, -16]!
	bl hx
	ldp x29, x30, [sp], 16
#elif defined(__x86_64__)
	subq $8, %rsp
	call hx
	addq $8, %rsp
#else
	call hx
#endif
	ret
	.section .note.GNU-stack,"",%progbits
#--- wbg.S
	.section .text.g,"axG",%progbits,g,comdat
	.weak g
	.type g,%function
g:
#if defined(__aarch64__)
	mov w0, #2
#else
	movl $2, %eax
#endif
	ret
	.weak hx
	.type hx,%function
hx:
#if defined(__aarch64__)
	mov w0, #40
#else
	movl $40, %eax
#endif
	ret
	.section .text.Y,"ax",%progbits
	.globl Y
	.type Y,%function
Y:
#if defined(__aarch64__)
	stp x29, x30, [sp, -16]!
	bl hx
	ldp x29, x30, [sp], 16
#elif defined(__x86_64__)
	subq $8, %rsp
	call hx
	addq $8, %rsp
#else
	call hx
#endif
	ret
	.section .note.GNU-stack,"",%progbits
