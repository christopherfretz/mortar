# A definition named after an archive does not keep a member out
# (resolve.md §4.1, review finding 1). The archive's member is the
# lowest-FileId definer of K, so a reference before the archive
# extracts it. With a weak definition after the archive, the member's
# strong one wins: GNU ld and lld run 2; mold does not extract and runs
# the weak 1. With a strong definition after it, the member is still
# extracted and the two clash: GNU ld and lld fail; mold links silently
# with the later one (3). mortar follows GNU ld and lld (R1 of the
# landed record, spec/landed/resolve/WP-022-spec.md).
#@ spec: resolve.md §4.1
#@ xfail(mortar): no linking yet (M1)

cc -O1 t1m.c -o t1m.o
cc -O1 t1k.c -o t1k.o
cc -O1 t1w.c -o t1w.o
cc -O1 t1s.c -o t1s.o
ar rcs libt1k.a t1k.o
link gcc -static -no-pie t1m.o -L. -lt1k t1w.o -o weak_after
run(bfd,lld,mortar) weak_after
  exit: 2
run(mold) weak_after
  exit: 1
link(bfd,lld,mortar) gcc -static -no-pie t1m.o -L. -lt1k t1s.o -o strong_after
  exit: fail
  diag(bfd): multiple definition of `K'
  diag(lld,mortar): duplicate symbol: K
link(mold) gcc -static -no-pie t1m.o -L. -lt1k t1s.o -o strong_after
run(mold) strong_after
  exit: 3

#--- t1m.c
int K(void);

int main(void) { return K(); }
#--- t1k.c
int K(void) { return 2; }
#--- t1w.c
__attribute__((weak)) int K(void) { return 1; }
#--- t1s.c
int K(void) { return 3; }
