# The output's `.symtab` keeps the inputs' local symbols and their file
# symbols (gABI "Symbol Table", STT_FILE); `-s` leaves out `.symtab` and
# `.strtab` and the program still runs. The binding of an executable's
# global symbols in `.symtab` DIFFERS: GNU ld and lld keep STB_GLOBAL,
# mold makes them STB_LOCAL. mortar keeps the binding of the inputs, as
# GNU ld does.
#@ spec: synth.md ".symtab"
#@ xfail(mortar): no linking yet (M1)

cc -O0 main.c -o main.o
link gcc -static -no-pie main.o -o full
link gcc -static -no-pie -s main.o -o stripped
check readelf -sW full
  has: FILE * main.c$
  has: FUNC LOCAL DEFAULT * local_helper$
  has: OBJECT LOCAL DEFAULT * local_counter$
  has(bfd,lld,mortar): FUNC GLOBAL DEFAULT * main$
  has(mold): FUNC LOCAL DEFAULT * main$
check readelf -SW stripped
  not: ] .symtab
  not: ] .strtab
run stripped
  exit: 3

#--- main.c
static int local_counter = 2;

static int local_helper(void) { return ++local_counter; }

int main(void) { return local_helper(); }
