# PENDING (WP-200; a verifier package): L3 finds `grp: M12 libhx.a(hx.o) is in the link and no root or live reference reaches it (resolve §4.1)` on mortar's output, on every architecture: the verifier's §4.1 still counts a dropped COMDAT copy's definition as first(K), which resolve.md §4.1's iterations and §6.2 no longer do (WP-200: a demoted mention is an undefined mention from the moment its copy is dropped). mortar's output was shown correct by its bytes and its run (spec/landed/resolve/WP-200.md §4). Rename this file to .test when the verifier follows §4.1's iterations.
# The keeper extracted after the copy it drops is read (WP-200; resolve.md
# §6.1, §6.2): wb2.o, named, calls A, which only libwa2.a's wa2.o
# defines; wa2.o has the lower FileId, so it keeps group g (§6.1) and
# wb2.o's copy, read first, is dropped: its weak hx is demoted from then
# on, and wu.o's strong hx extracts libhx.a's member in the closure's
# next iteration: Y and main call hx.o's hx, 7 + 7. grp: in a group;
# back: A a back reference. GNU ld (in the group) and lld keep the copy
# loaded first, wb2.o's, and bind hx to it: 40 + 40 (§6.1's recorded
# difference, ruling C); GNU ld refuses back (undefined reference to
# `A'); mold refuses both (undefined symbol: hx).
#@ spec: resolve.md §6.2
#@ spec: resolve.md §6.1
#@ arch: aarch64 x86_64 i386

as wa2.S -o wa2.o
as wb2.S -o wb2.o
cc -O1 hx.c -o hx.o
cc -O1 wu.c -o wu.o
ar rcs libhx.a hx.o
ar rcs libwa2.a wa2.o

link(mold) gcc -static -no-pie wu.o -Wl,--start-group libwa2.a wb2.o -Wl,--end-group libhx.a -o grp
  exit: fail
  diag(mold): undefined symbol: hx
link(bfd,lld,mortar) gcc -static -no-pie wu.o -Wl,--start-group libwa2.a wb2.o -Wl,--end-group libhx.a -o grp
run(bfd,lld) grp
  exit: 80
run(mortar) grp
  exit: 14
link(bfd,mold) gcc -static -no-pie wu.o libwa2.a wb2.o libhx.a -o back
  exit: fail
  diag(bfd): undefined reference to `A'
  diag(mold): undefined symbol: hx
link(lld,mortar) gcc -static -no-pie wu.o libwa2.a wb2.o libhx.a -o back
run(lld) back
  exit: 80
run(mortar) back
  exit: 14

#--- wa2.S
	.section .note.GNU-stack,"",%progbits
	.section .text.g,"axG",%progbits,g,comdat
	.weak g
	.type g,%function
g:
#if defined(__aarch64__)
	mov w0, #1
#else
	movl $1, %eax
#endif
	ret
	.text
	.globl A
	.type A,%function
A:
	ret
#--- wb2.S
	.section .text.g,"axG",%progbits,g,comdat
	.weak g
	.type g,%function
g:
#if defined(__aarch64__)
	mov w0, #2
#else
	movl $2, %eax
#endif
	ret
	.weak hx
	.type hx,%function
hx:
#if defined(__aarch64__)
	mov w0, #40
#else
	movl $40, %eax
#endif
	ret
	.text
	.globl Y
	.type Y,%function
Y:
#if defined(__aarch64__)
	stp x29, x30, [sp, -16]!
	bl A
	bl hx
	ldp x29, x30, [sp], 16
#elif defined(__x86_64__)
	subq $8, %rsp
	call A
	call hx
	addq $8, %rsp
#else
	call A
	call hx
#endif
	ret
	.section .note.GNU-stack,"",%progbits
#--- hx.c
int hx(void) { return 7; }
#--- wu.c
int Y(void);
int hx(void);
int main(void) { return Y() + hx(); }
