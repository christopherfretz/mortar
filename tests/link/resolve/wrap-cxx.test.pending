# PENDING (WP-153): every reference's and mortar's output draws L3 findings because the verifier does not follow --wrap yet; the verifier package for --wrap renames this file to .test.
# The common line (resolve.md §7.1, WP-153): --wrap=malloc, --wrap=free
# and --wrap=open as test doubles on a g++ link with libstdc++, whose
# templates and inline functions are COMDAT groups in every file, none of
# them a wrapped symbol: mortar links it, as the references do. In the
# static links libstdc++'s own calls of malloc are wrapped (its members
# are objects of the link: 150 and more calls); in the dynamic ones only
# the program's are (libstdc++.so's malloc calls bind at run time).
#@ spec: resolve.md §7.1
#@ arch: aarch64 x86_64
#@ requires: g++

cc -O1 w.c -o w.o
cxx -O1 m.cc -o m.o
link g++ -static m.o w.o -Wl,--wrap=malloc -Wl,--wrap=free -Wl,--wrap=open -o static
run static
  stdout: size=100 map=50 malloc>=150:1 open=1
link g++ -pie m.o w.o -Wl,--wrap=malloc -Wl,--wrap=free -Wl,--wrap=open -o dynamic
run dynamic
  stdout: size=100 map=50 malloc>=150:0 open=1
link g++ -no-pie m.o w.o -Wl,--wrap=malloc,--wrap=free,--wrap=open -o nopie
run nopie
  stdout: size=100 map=50 malloc>=150:0 open=1

#--- w.c
#include <stddef.h>
#include <stdarg.h>
void *__real_malloc(size_t);
void __real_free(void *);
int __real_open(const char *, int, ...);
unsigned long n_malloc, n_free, n_open;
void *__wrap_malloc(size_t s) { n_malloc++; return __real_malloc(s); }
void __wrap_free(void *p) { if (p) n_free++; __real_free(p); }
int __wrap_open(const char *p, int fl, ...) {
  va_list a;
  va_start(a, fl);
  int m = va_arg(a, int);
  va_end(a);
  n_open++;
  return __real_open(p, fl, m);
}
#--- m.cc
#include <cstdio>
#include <string>
#include <vector>
#include <map>
#include <fcntl.h>
#include <unistd.h>
extern "C" unsigned long n_malloc, n_free, n_open;
template <class T> struct Box { std::vector<T> v; void add(T t) { v.push_back(t); } };
int main() {
  unsigned long m0 = n_malloc;
  Box<std::string> b;
  for (int i = 0; i < 100; i++) b.add(std::string(40, 'a' + i % 26));
  std::map<int, std::string> mp;
  for (int i = 0; i < 50; i++) mp[i] = b.v[i];
  int fd = open("/dev/null", O_RDONLY);
  close(fd);
  std::printf("size=%zu map=%zu malloc>=150:%d open=%lu\n", b.v.size(), mp.size(),
              (n_malloc - m0) >= 150, n_open);
  return 0;
}
