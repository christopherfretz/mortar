# comdat-mismatch-weak-needed.test under --no-as-needed (WP-178): libhx.so
# is needed and defines hx, so the key is live and the reference through
# wb.o's demoted weak mention binds to the library's hx (resolve.md §6.2:
# it binds to the definition the link has), Y reads 7: exit 8. GNU ld,
# mold and mortar write that (on x86-64 -no-pie a COPY of hx). lld on
# x86-64 does not: it writes hx as a WEAK UND import and the absolute
# uses as 0 with no dynamic record (the A25 form for a key a needed
# library defines), so Y reads 0 and the program exits 1: a wrong
# output, the verifier's R2 (the library's address does not fit the
# 32-bit field the loader leaves unwritten). lld on AArch64 reads hx
# through a GOT entry with a GLOB_DAT record and exits 8.
#@ spec: resolve.md §6.2
#@ spec: dyn.md D-11
#@ xfail(lld,x86_64): lld writes the reference through a demoted weak mention whose key libhx.so defines as an undefined weak import with no record for its absolute uses (Y reads 0, exit 1; the verifier's R2 at the uses)
#@ arch: aarch64 x86_64

cc -O1 -fno-pie wm.c -o wm.o
cc -O1 -fno-pie wa.c -o wa.o
cc -O1 -fno-pie wb.c -o wb.o
cc -O1 -fPIC hxs.c -o hxs.o
shlib gcc hxs.o -Wl,-soname,libhx.so -o libhx.so

link gcc -no-pie wm.o wa.o wb.o -Wl,--no-as-needed -L. -lhx -o nasn
run nasn
  exit: 8
check readelf -dW nasn
  has: (NEEDED) Shared library: [libhx.so]

#--- wm.c
extern int g;
int Y(void);
int main(void) { return Y() + g; }
#--- wa.c
__asm__(".section .data.g,\"awG\",%progbits,g,comdat\n"
        ".weak g\n.type g,%object\n.size g,4\ng: .long 1\n.previous\n");
#--- wb.c
__asm__(".section .data.g,\"awG\",%progbits,g,comdat\n"
        ".weak g\n.type g,%object\n.size g,4\ng: .long 2\n"
        ".weak hx\n.type hx,%object\n.size hx,4\nhx: .long 40\n.previous\n");
extern int hx __attribute__((weak));
int Y(void) { return &hx ? hx : 0; }
#--- hxs.c
int hx = 7;
