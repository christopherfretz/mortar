# A Mason object (spec/meta.md T-MT-3): a container written by the test
# producer (`cargo xtask meta write`, the description below) and a second
# one of garbage bytes (T-MT-42: a valid section header, contents no
# reader would accept), in an object that defines what main needs, linked
# directly and as an archive member. Every linker drops the section
# (MT-3; mortar: MT-6 consumes it, MT-31/MT-33) and produces the same
# program; mortar reads no container byte and reports nothing (MT-42).
#
# The first container is the output of `cargo xtask meta write` for:
#   summary name=lang value=c++
#   definition name=meta_value class=2 file=meta.h line=1
#   declaration name=meta_value ty=0 size=4 type_name=int flags=3
#@ spec: meta.md "MT-3", "MT-6", "MT-42"

as meta.s -o meta.o
ar rcs libmeta.a meta.o
cc -O1 main.c -o main.o
link gcc -static -no-pie main.o meta.o -o prog
  no-diag: meta
  no-diag: Mason
run prog
  exit: 42
check readelf -SW prog
  not: .mason.meta
link gcc -static -no-pie main.o -L. -lmeta -o prog2
  no-diag: meta
  no-diag: Mason
run prog2
  exit: 42
check readelf -SW prog2
  not: .mason.meta

#--- main.c
extern const int meta_value;

int main(void) { return meta_value; }
#--- meta.s
	.section .mason.meta,"e",%progbits
	.p2align 3
	.byte 0x4d,0x41,0x53,0x4e,0x01,0x00,0x00,0x00,0xd8,0x00,0x00,0x00,0x20,0x00,0x00,0x00
	.byte 0x03,0x00,0x00,0x00,0xb8,0x00,0x00,0x00,0x20,0x00,0x00,0x00,0x04,0x00,0x00,0x00
	.byte 0x01,0x00,0x01,0x00,0x20,0x00,0x00,0x00,0x10,0x00,0x00,0x00,0x01,0x00,0x00,0x00
	.byte 0x01,0x00,0x00,0x00,0x06,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00
	.byte 0x02,0x00,0x01,0x00,0x40,0x00,0x00,0x00,0x30,0x00,0x00,0x00,0x01,0x00,0x00,0x00
	.byte 0x4a,0x8b,0xb3,0x48,0xbf,0xef,0x99,0x3b,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00
	.byte 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x0a,0x00,0x00,0x00,0x02,0x00,0x00,0x00
	.byte 0x00,0x00,0x00,0x00,0x15,0x00,0x00,0x00,0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x00
	.byte 0x05,0x00,0x01,0x00,0x38,0x00,0x00,0x00,0x28,0x00,0x00,0x00,0x01,0x00,0x00,0x00
	.byte 0x4a,0x8b,0xb3,0x48,0xbf,0xef,0x99,0x3b,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00
	.byte 0x04,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x0a,0x00,0x00,0x00,0x1c,0x00,0x00,0x00
