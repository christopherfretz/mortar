	.section .mason.meta,"e",%progbits,unique,2
	.p2align 3
	.byte 0x4d,0x41,0x53,0x4e,0x07,0x00,0x00,0x00,0xff,0xff,0xff,0x7f,0x13,0x37,0xde,0xad
