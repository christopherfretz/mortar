# Erratum 843419 at a direct page (275) of a string in a merged section,
# through its section symbol and an addend (`.rodata.str1.1 + 5`, as GAS
# writes a `.L` label there; WP-103). fill's `S` is the piece at the target
# offset (model 4.5), not the piece at the symbol's: s.o, linked first,
# has the same strings 8 KiB apart and in the other order, so the two
# differ by pages. Until WP-103 the erratum scan took the piece at offset
# 0 plus the addend.
#@ spec: a64.md "11.1 The predicate"
#@ spec: a64.md "11.2 The fix"
#@ arch: aarch64
# GNU ld's static PIE: the GOT slot of glibc's absolute
# `_nl_current_*_used` gets a RELATIVE record (plumb.md 10.2).
#@ anomaly(bfd): A30

as f.S -o f.o
as s.S -o s.o
cc -O1 -fno-pie main.c -o main-static.o
cc -O1 -fPIE main.c -o main-static-pie.o
cc -O1 -fPIE main.c -o main-pie-now.o
cc -O1 -fPIE main.c -o main-pie-lazy.o
cc -O1 -fno-pie main.c -o main-exec.o
# a static executable; the option spelled (the x86-64 host's cross driver may not pass it).
link gcc -static -no-pie -Wl,--fix-cortex-a53-843419 main-static.o s.o f.o -o static
run static
  stdout: ok
check(mortar) objdump -d --disassemble=f static
  has: ff8: * adr x0, 
  has: ffc: * adr x0, 
check(bfd) objdump -d --disassemble=f static
  has: ff8: * adr x0, 
  has: ffc: * adr x0, 
# a static PIE; the option spelled (the x86-64 host's cross driver may not pass it).
link gcc -static-pie -Wl,--fix-cortex-a53-843419 main-static-pie.o s.o f.o -o static-pie
run static-pie
  stdout: ok
check(mortar) objdump -d --disassemble=f static-pie
  has: ff8: * adr x0, 
  has: ffc: * adr x0, 
check(bfd) objdump -d --disassemble=f static-pie
  has: ff8: * adr x0, 
  has: ffc: * adr x0, 
# a PIE, -z now; the option spelled (the x86-64 host's cross driver may not pass it).
link gcc -pie -Wl,-z,now -Wl,--fix-cortex-a53-843419 main-pie-now.o s.o f.o -o pie-now
run pie-now
  stdout: ok
check(mortar) objdump -d --disassemble=f pie-now
  has: ff8: * adr x0, 
  has: ffc: * adr x0, 
check(bfd) objdump -d --disassemble=f pie-now
  has: ff8: * adr x0, 
  has: ffc: * adr x0, 
# a PIE, lazy; the option spelled (the x86-64 host's cross driver may not pass it).
link gcc -pie -Wl,-z,lazy -Wl,--fix-cortex-a53-843419 main-pie-lazy.o s.o f.o -o pie-lazy
run pie-lazy
  stdout: ok
check(mortar) objdump -d --disassemble=f pie-lazy
  has: ff8: * adr x0, 
  has: ffc: * adr x0, 
check(bfd) objdump -d --disassemble=f pie-lazy
  has: ff8: * adr x0, 
  has: ffc: * adr x0, 
# a dynamic executable; the option spelled (the x86-64 host's cross driver may not pass it).
link gcc -no-pie -Wl,--fix-cortex-a53-843419 main-exec.o s.o f.o -o exec
run exec
  stdout: ok
check(mortar) objdump -d --disassemble=f exec
  has: ff8: * adr x0, 
  has: ffc: * adr x0, 
check(bfd) objdump -d --disassemble=f exec
  has: ff8: * adr x0, 
  has: ffc: * adr x0, 

#--- f.S
	.section .text.f,"ax",%progbits
	.balign	4096
	.globl	f
	.type	f, %function
f:
	stp	x29, x30, [sp, #-16]!
	mov	x10, x0
	.rept	1020
	nop
	.endr
	// the site at 0xFF8: W1, W2, then the final word
	adrp	x0, .LChello
	ldr	x9, [sp]
	ldrb	w9, [x0, :lo12:.LChello]
	add	x0, x0, :lo12:.LChello
	str	x0, [x10]
	.rept	1020
	nop
	.endr
	// the site at 0xFFC of the next page
	adrp	x0, .LChello
	ldr	x9, [sp]
	ldrb	w9, [x0, :lo12:.LChello]
	add	x0, x0, :lo12:.LChello
	str	x0, [x10, #8]
	ldp	x29, x30, [sp], #16
	ret
	.size	f, .-f
	.section .rodata.str1.1,"aMS",%progbits,1
.LCa:	.string	"aaaa"
.LChello:	.string	"hello, merged"
	.section .note.GNU-stack,"",%progbits
#--- main.c
#include <stdio.h>
const char *hello(void);
void f(void **out);

int main(void) {
  void *o[2];
  f(o);
  void *want = (void *)hello();
  if (o[0] != want || o[1] != want) {
    printf("wrong: %p %p, want %p\n", o[0], o[1], want);
    return 1;
  }
  puts("ok");
  return 0;
}
#--- s.S
// "hello, merged" first, 8 KiB of other text, then "aaaa": f.o's pieces
// land far apart and in the other order.
	.text
	.globl	hello
	.type	hello, %function
hello:	adrp	x0, .LS
	add	x0, x0, :lo12:.LS
	ret
	.section .rodata.str1.1,"aMS",%progbits,1
.LS:	.string	"hello, merged"
	.string	""
	.string	"aaaa"
	.section .note.GNU-stack,"",%progbits
