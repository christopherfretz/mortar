# --gdb-index (WP-097, spec/synth.md §17): what mortar refuses by name
# rather than write an index that hides names from gdb, and what lld and
# mold write instead.
# - A mixed build: a unit with debug information and no GNU name index
#   (GCC -g without -ggnu-pubnames) linked with units that have one.
#   lld and mold write an index without its names, which gdb trusts
#   (WP-080 stage B §2.1: `ptype ns::OnlyInC` finds nothing; the session
#   is in crates/mortar/tests/debuggers.rs); mortar refuses it as
#   gdb-index-incomplete at that object (S-G3).
# - Clang -gpubnames: per-unit .debug_names only, not read (S-G4a), so
#   incomplete, with a note naming .debug_names.
# - Type units: DWARF 4's .debug_types and DWARF 5's DW_UT_type
#   (S-G2, gdb-index-type-unit).
# - Hand-written name sets (x.S): an attribute byte with bits 0-3 set
#   (gdb-index-malformed-name-set, S-G4a); a set naming the .debug_info
#   of a COMDAT group that was not kept (gdb-index-orphan-name-set,
#   S-G5a); a root DW_TAG_partial_unit (gdb-index-malformed-unit, S-G2).
#   The well-formed variant links, with its names.
# - --incremental (IN-12, IN-58): a warning, a plain link with its index.
# - --debug-names: refused with S-G9's reason; --no-debug-names: a no-op.
#@ skip(bfd): GNU ld has no --gdb-index
#@ spec: synth.md S-G2 S-G3 S-G4a S-G5a S-G8 S-G9; incr.md IN-12 IN-58
#@ requires: g++ clang

cxx -g -gsplit-dwarf -O0 main.cc -o main.o
cxx -g -gsplit-dwarf -O0 b.cc -o b.o
cxx -g -O0 c.cc -o c-np.o
cxx -g -ggnu-pubnames -O0 c.cc -o c-gn.o
cxx(clang) -g -gsplit-dwarf -gdwarf-5 -gpubnames -O0 c.cc -o c-names.o
cxx -g -gdwarf-4 -ggnu-pubnames -fdebug-types-section -O0 c.cc -o c-types4.o
cxx(clang) -g -gdwarf-5 -ggnu-pubnames -fdebug-types-section -O0 c.cc -o c-types5.o
as -DGOOD x.S -o x-good.o
as -DBAD_ATTR x.S -o x-bad.o
as -DPARTIAL x.S -o x-partial.o
as -DGROUP x.S -o x-group1.o
as -DGROUP -DORPHAN x.S -o x-group2.o
link(lld,mold) g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main.o b.o c-np.o -o mixed
run(lld,mold) mixed
  stdout: 5 10 15
check(lld,mold) readelf --debug-dump=gdb_index mixed
  has: helper: 1 [global, function]
  not: ns::OnlyInC
  not: g_only_c
link(mortar) g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main.o b.o c-np.o -o mixed
  exit: fail
  diag: c-np.o:* unsupported feature: gdb-index-incomplete
  diag: has debug information and no .debug_gnu_pubnames set
  diag: compile it with -ggnu-pubnames, or link without --gdb-index (spec/synth.md S-G3)
link g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main.o b.o c-gn.o -o pure
run pure
  stdout: 5 10 15
check readelf --debug-dump=gdb_index pure
  has: ns::c_fn: 2 [global, function]
  has: g_only_c: 2 [global, variable]
link(mortar) g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main.o b.o c-names.o -o names
  exit: fail
  diag: c-names.o:* unsupported feature: gdb-index-incomplete
  diag: .debug_names
link(mortar) g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main.o b.o c-types4.o -o types4
  exit: fail
  diag: c-types4.o:* unsupported feature: gdb-index-type-unit
link(mortar) g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main.o b.o c-types5.o -o types5
  exit: fail
  diag: c-types5.o:* unsupported feature: gdb-index-type-unit
link g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main.o b.o c-gn.o x-good.o -o good
run good
  stdout: 5 10 15
check readelf --debug-dump=gdb_index good
  has: x_name: 3 [global, variable]
  has: x_type: 3 [static, type]
link(mortar) g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main.o b.o c-gn.o x-bad.o -o bad
  exit: fail
  diag: x-bad.o:* unsupported feature: gdb-index-malformed-name-set
link(mortar) g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main.o b.o c-gn.o x-partial.o -o partial
  exit: fail
  diag: x-partial.o:* unsupported feature: gdb-index-malformed-unit
link(mortar) g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main.o b.o c-gn.o x-group1.o x-group2.o -o orphan
  exit: fail
  diag: x-group2.o:* unsupported feature: gdb-index-orphan-name-set
# Without the option none of them is read: each links.
link g++ -static -no-pie -fno-use-linker-plugin main.o b.o c-np.o x-bad.o x-partial.o x-group1.o x-group2.o -o plain
run plain
  stdout: 5 10 15
link(mortar) g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index -Wl,--incremental main.o b.o c-gn.o -o incr
  diag: --incremental is not supported with --gdb-index; linking without a state
check(mortar) readelf -SW incr
  has: .gdb_index
link(mortar) g++ -static -no-pie -fno-use-linker-plugin -Wl,--debug-names main.o b.o c-gn.o -o dn
  exit: fail
  diag: unsupported option: --debug-names
  diag: gdb 16 ignores a .debug_names it did not write; use --gdb-index (spec/synth.md S-G9)
# (mold has no --no-debug-names.)
link(lld,mortar) g++ -static -no-pie -fno-use-linker-plugin -Wl,--no-debug-names main.o b.o c-gn.o -o ndn
run(lld,mortar) ndn
  stdout: 5 10 15

#--- main.cc
#include <cstdio>
template <class T> __attribute__((noinline)) T twice(T x) { return x + x; }
struct Point { int x; double y; };
int g_total = 3;
int helper(int);
int c_use();
int main(int argc, char **) {
  Point p{argc, 2.5};
  std::printf("%d %d %d\n", twice(argc) + g_total, helper(argc) + (int)p.y, c_use());
  return 0;
}
#--- b.cc
template <class T> __attribute__((noinline)) T twice(T x) { return x + x; }
__attribute__((noinline)) int unused_fn(int x) { return x * 9; }
__attribute__((noinline)) int helper(int x) { return twice(x + 1) + 4; }
#--- c.cc
namespace ns { struct OnlyInC { int a; long b; }; __attribute__((noinline)) int c_fn(int x) { return x * 3; } }
ns::OnlyInC g_only_c = {4, 2};
static int s_c_static = 3;
int c_use() { return ns::c_fn(g_only_c.a) + s_c_static; }
#--- x.S
/* One DWARF 4 unit with a child DIE and its GNU name sets, written by
   hand: GOOD links; BAD_ATTR gives a name an attribute byte with bits
   0-3 set; PARTIAL makes the root a DW_TAG_partial_unit; GROUP puts the
   .debug_info in COMDAT group xgrp (ORPHAN: the second copy, dropped,
   which its file's sets still name). */
#ifdef __LP64__
#define ADDR_SIZE 8
#else
#define ADDR_SIZE 4
#endif
#ifdef PARTIAL
#define ROOT 0x3c
#else
#define ROOT 0x11
#endif
#ifdef BAD_ATTR
#define NAME_ATTR 0x21
#else
#define NAME_ATTR 0x20
#endif
	.section .debug_abbrev,"",%progbits
.Labbrev:
	.uleb128 1
	.uleb128 ROOT
	.byte 1
	.uleb128 0x03
	.uleb128 0x08
	.byte 0, 0
	.uleb128 2
	.uleb128 0x24
	.byte 0
	.uleb128 0x03
	.uleb128 0x08
	.byte 0, 0
	.byte 0
#ifdef GROUP
	.section .debug_info,"G",%progbits,xgrp,comdat
#else
	.section .debug_info,"",%progbits
#endif
.Lcu:
	.long .Lcu_end - .Lcu_start
.Lcu_start:
	.short 4
	.long .Labbrev
	.byte ADDR_SIZE
	.uleb128 1
	.asciz "x.S"
	.uleb128 2
	.asciz "x_type"
	.byte 0
.Lcu_end:
	.section .debug_gnu_pubnames,"",%progbits
	.long .Lpn_end - .Lpn_start
.Lpn_start:
	.short 2
	.long .Lcu
	.long .Lcu_end - .Lcu
	.long 0x1c
	.byte NAME_ATTR
	.asciz "x_name"
	.long 0
.Lpn_end:
	.section .debug_gnu_pubtypes,"",%progbits
	.long .Lpt_end - .Lpt_start
.Lpt_start:
	.short 2
	.long .Lcu
	.long .Lcu_end - .Lcu
	.long 0x10
	.byte 0x90
	.asciz "x_type"
	.long 0
.Lpt_end:
