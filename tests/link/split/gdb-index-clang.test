# --gdb-index (WP-097, spec/synth.md §17), Clang 22: -gsplit-dwarf (whose
# default writes the GNU name index) at DWARF 5 and 4, and a non-split
# -ggnu-pubnames build at DWARF 5, plain and with --gc-sections; the
# program and checks of gdb-index-gcc.test. Clang's DWARF 5 skeletons
# give their ranges through DW_AT_ranges/rnglistx and .debug_addr
# (S-G5); its non-split units are ordinary compile units with children.
# Clang -gpubnames (.debug_names) is refused: gdb-index-refused.test.
#@ skip(bfd): GNU ld has no --gdb-index
#@ spec: synth.md S-G1 S-G2 S-G4 S-G5 S-G5a S-G6 S-G7
#@ requires: g++ clang llvm-dwarfdump

cxx(clang) -g -gsplit-dwarf -gdwarf-5 -O0 -ffunction-sections main.cc -o main-d5.o
cxx(clang) -g -gsplit-dwarf -gdwarf-5 -O0 -ffunction-sections b.cc -o b-d5.o
cxx(clang) -g -gsplit-dwarf -gdwarf-5 -O0 -ffunction-sections c.cc -o c-d5.o
cxx(clang) -g -gsplit-dwarf -gdwarf-4 -O0 -ffunction-sections main.cc -o main-d4.o
cxx(clang) -g -gsplit-dwarf -gdwarf-4 -O0 -ffunction-sections b.cc -o b-d4.o
cxx(clang) -g -gsplit-dwarf -gdwarf-4 -O0 -ffunction-sections c.cc -o c-d4.o
cxx(clang) -g -gdwarf-5 -ggnu-pubnames -O0 -ffunction-sections main.cc -o main-gn.o
cxx(clang) -g -gdwarf-5 -ggnu-pubnames -O0 -ffunction-sections b.cc -o b-gn.o
cxx(clang) -g -gdwarf-5 -ggnu-pubnames -O0 -ffunction-sections c.cc -o c-gn.o
link g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main-d5.o b-d5.o c-d5.o -o prog-d5
run prog-d5
  stdout: 5 10 15
check readelf -SW prog-d5
  has: .gdb_index
  not: .debug_gnu_pubnames
check readelf --debug-dump=gdb_index prog-d5
  has: Version 7
  has: twice<int>:
  has: ns::c_fn: 2 [global, function]
  has: g_only_c: 2 [global, variable]
  has: helper: 1 [global, function]
check llvm-dwarfdump --gdb-index prog-d5
  has: CU list offset = 0x18, has 3 entries:
  not: error
link g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main-d4.o b-d4.o c-d4.o -o prog-d4
run prog-d4
  stdout: 5 10 15
check readelf -SW prog-d4
  has: .gdb_index
  not: .debug_gnu_pubnames
check readelf --debug-dump=gdb_index prog-d4
  has: Version 7
  has: twice<int>:
  has: ns::c_fn: 2 [global, function]
  has: g_only_c: 2 [global, variable]
  has: helper: 1 [global, function]
check llvm-dwarfdump --gdb-index prog-d4
  has: CU list offset = 0x18, has 3 entries:
  not: error
link g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index main-gn.o b-gn.o c-gn.o -o prog-gn
run prog-gn
  stdout: 5 10 15
check readelf -SW prog-gn
  has: .gdb_index
  not: .debug_gnu_pubnames
check readelf --debug-dump=gdb_index prog-gn
  has: Version 7
  has: twice<int>:
  has: ns::c_fn: 2 [global, function]
  has: g_only_c: 2 [global, variable]
  has: helper: 1 [global, function]
check llvm-dwarfdump --gdb-index prog-gn
  has: CU list offset = 0x18, has 3 entries:
  not: error
link g++ -static -no-pie -fno-use-linker-plugin -Wl,--gdb-index -Wl,--gc-sections main-d5.o b-d5.o c-d5.o -o prog-gc
run prog-gc
  stdout: 5 10 15
check nm prog-gc
  not: unused_fn
check readelf --debug-dump=gdb_index prog-gc
  has: unused_fn: 1 [global, function]
check llvm-dwarfdump --gdb-index prog-gc
  has: CU list offset = 0x18, has 3 entries:
  not: error

#--- main.cc
#include <cstdio>
template <class T> __attribute__((noinline)) T twice(T x) { return x + x; }
struct Point { int x; double y; };
int g_total = 3;
int helper(int);
int c_use();
int main(int argc, char **) {
  Point p{argc, 2.5};
  std::printf("%d %d %d\n", twice(argc) + g_total, helper(argc) + (int)p.y, c_use());
  return 0;
}
#--- b.cc
template <class T> __attribute__((noinline)) T twice(T x) { return x + x; }
__attribute__((noinline)) int unused_fn(int x) { return x * 9; }
__attribute__((noinline)) int helper(int x) { return twice(x + 1) + 4; }
#--- c.cc
namespace ns { struct OnlyInC { int a; long b; }; __attribute__((noinline)) int c_fn(int x) { return x * 3; } }
ns::OnlyInC g_only_c = {4, 2};
static int s_c_static = 3;
int c_use() { return ns::c_fn(g_only_c.a) + s_c_static; }
