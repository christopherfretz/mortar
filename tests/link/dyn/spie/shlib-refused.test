# dyn.md D-2: a static-pie is not a dynamic link, so a shared library on
# its line is refused by name (input.md §8.4: "attempted static link of
# dynamic object"), as GNU ld and lld refuse it (measured, both
# architectures, the same words). mold links it: its output names no
# library and the call has nowhere to go (W-class: not checked here).
#
#@ spec: dyn.md "D-2"
#@ spec: input.md §8.4
#@ arch: aarch64 x86_64
#@ fixture: greet

cc -O1 -fPIE main.c -o main.o
link(bfd,lld,mortar) gcc -static-pie main.o libgreet.so -o spie
  exit: fail
  diag: attempted static link of dynamic object
link(mold) gcc -static-pie main.o libgreet.so -o spie

#--- main.c
#include "greet.h"

int main(void) { return greet("spie") == 41 ? 0 : 1; }
