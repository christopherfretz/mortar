# x86-64 large sections in a static-pie (spec/x64.md X-52, layout.md
# L-36a, dyn.md D-1; WP-084's rules, WP-052's output kind): the medium and
# large code models' `.lbss`, `.ldata`, `.lrodata` (GCC and Clang) and
# Clang's large-model `.ltext`, C and C++ (exceptions, a thread_local).
# The PIE and -no-pie cases are dyn/layout/x64-large-sections, the static
# ones layout/x64-large-sections. Only the programs' output and the
# sections' `SHF_X86_64_LARGE` (readelf's `l`) are compared: placement is
# X-54's, each linker its own way. Measured (WP-052 record §9): GNU ld
# links the GCC and Clang-medium programs, its Clang-large C dies by
# SIGSEGV and it refuses both large-model C++ links; lld's clang++ large
# program aborts on its throw (A29, which the verifier also names on the
# C program); mold links and runs all eight. GNU ld's A31 is
# crtbeginS's `.plt.got` entry, as in every static-pie of its.
#
#@ spec: x64.md "X-52"
#@ spec: layout.md "L-36a"
#@ spec: dyn.md "D-1"
#@ arch: x86_64
#@ requires: g++ clang
#@ anomaly(bfd): A31
#@ anomaly(lld): A29
#@ xfail(bfd): GNU ld 2.46's static-pie of Clang -mcmodel=large C dies by SIGSEGV; it refuses the large-model C++ (R_X86_64_PLTOFF64/GOT64 against the IFUNC strlen)
#@ xfail(lld): A29: lld 22's .eh_frame_hdr leaves Clang's large-model .ltext FDEs unfindable; the clang++ -mcmodel=large program's throw aborts

cc -O2 -mcmodel=medium -fPIE -fno-common lg.c -o gm.o
cc -O2 -mcmodel=large -fPIE -fno-common lg.c -o gl.o
cc(clang) -O2 -mcmodel=medium -fPIE lg.c -o cm.o
cc(clang) -O2 -mcmodel=large -fPIE lg.c -o cl.o
cc -O2 -fPIE ext.c -o ext.o
cxx -O2 -mcmodel=medium -fPIE lg.cc -o xm.o
cxx -O2 -mcmodel=large -fPIE lg.cc -o xl.o
cxx(clang) -O2 -mcmodel=medium -fPIE lg.cc -o ym.o
cxx(clang) -O2 -mcmodel=large -fPIE lg.cc -o yl.o

link gcc -static-pie gm.o ext.o -o gm
link gcc -static-pie gl.o ext.o -o gl
link gcc -static-pie cm.o ext.o -o cm
link gcc -static-pie cl.o ext.o -o cl
link g++ -static-pie xm.o -o xm
link g++ -static-pie xl.o -o xl
link g++ -static-pie ym.o -o ym
link g++ -static-pie yl.o -o yl

run gm
  stdout: 5 1 2 6 3 0 4 b 42
run gl
  stdout: 5 1 2 6 3 0 4 b 42
run cm
  stdout: 5 1 2 6 3 0 4 b 42
run cl
  stdout: 5 1 2 6 3 0 4 b 42
run xm
  stdout: 7 8 3 1.5 9 1
run xl
  stdout: 7 8 3 1.5 9 1
run ym
  stdout: 7 8 3 1.5 9 1
run yl
  stdout: 7 8 3 1.5 9 1

check readelf -SW gm
  has: .lbss NOBITS * WAl 
  has: .ldata PROGBITS * WAl 
  has: .lrodata PROGBITS * Al 
check readelf -SW cl
  has: .ltext PROGBITS * AXl 
check readelf -lW yl
  has: GNU_EH_FRAME
  not: INTERP

#--- lg.c
#include <stdio.h>
#ifndef BIG
#define BIG (1<<20)
#endif
static char lb[BIG];                 /* .lbss */
char ld_[BIG] = {1};                 /* .ldata */
const char lr[1<<20] = {2};          /* .lrodata */
char lc[BIG];                        /* LCOMMON with -fcommon */
int small_d = 3; int small_b; const int small_r = 4;
extern int ext_fn(int);
static const char *strs[] = {"a", "b"};
int main(void){ lb[BIG-1]=5; lc[BIG-1]=6; printf("%d %d %d %d %d %d %d %s %d\n", lb[BIG-1], ld_[0], lr[0], lc[BIG-1], small_d, small_b, small_r, strs[1], ext_fn(1)); return 0; }
#--- ext.c
int ext_fn(int x) { return x + 41; }
#--- lg.cc
#include <cstdio>
#include <string>
#include <stdexcept>
struct Big { int v[1<<18]; Big() { v[0] = 7; v[(1<<18)-1] = 8; } virtual ~Big() {} virtual int f() const { return v[0]; } };
Big big_obj;                               // .lbss (ctor-initialised)
static int table[1<<17] = {1, 2, 3};       // .ldata
const double ctab[1<<15] = {1.5};          // .lrodata
thread_local int tl = 9;
static int thrower(int x) { if (x > 1) throw std::runtime_error("boom"); return x; }
int main() {
  int caught = 0;
  try { thrower(3); } catch (const std::exception &e) { caught = std::string(e.what()) == "boom"; }
  std::printf("%d %d %d %g %d %d\n", big_obj.f(), big_obj.v[(1<<18)-1], table[2], ctab[0], tl, caught);
}
