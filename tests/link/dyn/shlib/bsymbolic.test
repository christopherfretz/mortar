# The `-Bsymbolic` family (`-Bsymbolic`, `-Bsymbolic-functions`,
# `--Bsymbolic-non-weak`, `--Bsymbolic-non-weak-functions`,
# `-Bno-symbolic`): `noop` rows of docs/status/options.md, "it binds a
# shared object's references to its own definitions; an executable's are
# bound locally already, and GNU ld writes nothing for it in an
# executable (shared objects as output are M4)". The program below defines
# a function its shared library calls back (`greet_hook`, so in
# `.dynsym`) and calls one of its own through a global: each option's link
# is the same bytes as the link without it, and no DT_SYMBOLIC or
# DF_SYMBOLIC is written. GNU ld does not know the two `--Bsymbolic-non-weak`
# options, so those lines are lld's, mold's and mortar's.
#
# The references DIFFER: lld writes DF_SYMBOLIC (DT_FLAGS 0x2) for
# `-Bsymbolic` in an executable; GNU ld and mold write nothing, and mortar
# follows them. The verifier judges lld's DF_SYMBOLIC P-D6 ("DT_FLAGS 0x2
# has bits 0x2 (D-30)") though the option line asks for it (WP-112
# finding V2), so lld's `-Bsymbolic` link is left out here.
#@ spec: cli.md "§3.6"
#@ arch: aarch64 x86_64
#@ fixture: greet

cc -O1 -fno-pie main.c -o main.o
link gcc -no-pie main.o -L. -lgreet -o plain
link(bfd,mold,mortar) gcc -no-pie main.o -L. -lgreet -Wl,-Bsymbolic -o bs
link gcc -no-pie main.o -L. -lgreet -Wl,-Bsymbolic-functions -o bsf
link(lld,mold,mortar) gcc -no-pie main.o -L. -lgreet -Wl,--Bsymbolic-non-weak -o bsnw
link(lld,mold,mortar) gcc -no-pie main.o -L. -lgreet -Wl,--Bsymbolic-non-weak-functions -o bsnwf
link gcc -no-pie main.o -L. -lgreet -Wl,-Bsymbolic -Wl,-Bno-symbolic -o bns
run plain
  stdout: hello, symbolic
  stdout: hook own 41
run(bfd,mold,mortar) bs
  stdout: hello, symbolic
  stdout: hook own 41
check readelf -dsW plain
  has: greet_hook$
  not: SYMBOLIC
check(bfd,mold,mortar) readelf -dW bs
  not: SYMBOLIC
check(bfd,mortar) cmp bs plain
  has: ^identical$
check(bfd,mortar) cmp bsf plain
  has: ^identical$
check(mortar) cmp bsnw plain
  has: ^identical$
check(mortar) cmp bsnwf plain
  has: ^identical$
check(bfd,mortar) cmp bns plain
  has: ^identical$

#--- main.c
#include <stdio.h>
#include "greet.h"
void greet_hook(void) { printf("hook"); }
int own(int x) { return x + 1; }
int (*volatile ownp)(int) = own;
int main(void) {
  int n = greet("symbolic");
  printf(" own %d\n", ownp(n - 1));
  return 0;
}
