  then(lld): [libnb.so]
  then(lld): [libnc.so]
  then(lld): [libc.so.6]
  count(mold): 4 (NEEDED)
  has(mold): [libna.so]
  then(mold): [libnb.so]
  then(mold): [libnc.so]
  then(mold): [libc.so.6]
run(bfd,mortar) s-on-then-s-off
  stdout: nc nx nb na main
run(lld) s-on-then-s-off
  stdout: nc nb nx na main
run(mold) s-on-then-s-off
  stdout: nc nb na main

# s_off_ref_s_on: referenced before a script named --as-needed at the end:
# kept there, after libnc.so (GNU ld; lld and mold at the first mention).
link gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so libnb.so -Wl,--no-as-needed use_x.o libnc.so s_x.so -o s-off-ref-s-on
