  stdout: nc nb na main

# n_sanx_off: AS_NEEDED inside the nested script (mold cannot read
# AS_NEEDED in a nested script: `library not found: AS_NEEDED`).
link(bfd,lld,mortar) gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so -Wl,--no-as-needed libnb.so n_sanx.so libnc.so -o n-sanx-off
