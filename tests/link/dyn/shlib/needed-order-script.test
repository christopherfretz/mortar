run(lld,mold) s-off-ref-s-on
  stdout: nc nx na main

# cli_group_nested: a nested script inside a command-line group.
link gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so -Wl,--no-as-needed libnb.so -Wl,--start-group -Wl,--as-needed n_sx.so -Wl,--no-as-needed use_x.o -Wl,--end-group libnc.so -o cli-group-nested
