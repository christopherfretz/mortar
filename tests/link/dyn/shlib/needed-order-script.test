# dyn.md D-19a (WP-172): a shared object mentioned again inside a linker
# script is placed by that mention's own as-needed state (the one in force
# where its script was named, AS_NEEDED(...) forcing it on,
# --push-state/--pop-state applied) and its group. Each program prints its
# constructors (the reverse of the loader's order) and "main"; fixture
# needed-libs. Measured with GNU ld 2.44, lld 19 and mold 2.37.1 on AArch64
# and x86-64 (identical lists): mortar writes GNU ld's list on every line
# GNU ld links (spec/landed/dyn/WP-172.md section 2).
#
# Where the references differ (dyn.md 13.1, "DT_NEEDED order"): lld writes
# each soname at its first mention; mold drops a library whose first
# mention is as-needed and unreferenced even when a later one is plain
# (W9). Each linker has its own list below, and its own run.
#@ spec: dyn.md "D-19a"
#@ xfail(mold): W9: an unreferenced library first named --as-needed and later plainly is dropped from DT_NEEDED
#@ arch: aarch64 x86_64
#@ fixture: needed-libs

cc -O1 -fPIE use_x.c -o use_x.o
cc -O1 -fPIE -DREFS=f_nx() main.c -o main_x.o
cc -O1 -fPIE "-DREFS=f_nx()+f_ny()" main.c -o main_xy.o
cc -O1 -fPIC -DN=dx who.c -o dx.o
shlib gcc dx.o -Wl,-soname,libdx.so -o libdx.so
cc -O1 -fPIC -DN=dy who.c -o dy.o
shlib gcc dy.o -Wl,-soname,libdy.so -o libdy.so
cc -O1 -fPIE mw.c -o main_w.o

# s_named_off: the script INPUT(libnx.so) named under --no-as-needed after
# an as-needed, unreferenced libnx.so: kept at the script (GNU ld).
link gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so -Wl,--no-as-needed libnb.so s_x.so libnc.so -o s-named-off
check readelf -dW s-named-off
  count(bfd,mortar): 5 (NEEDED)
  has(bfd,mortar): [libna.so]
  then(bfd,mortar): [libnb.so]
  then(bfd,mortar): [libnx.so]
  then(bfd,mortar): [libnc.so]
  then(bfd,mortar): [libc.so.6]
  count(lld): 5 (NEEDED)
  has(lld): [libna.so]
  then(lld): [libnx.so]
  then(lld): [libnb.so]
  then(lld): [libnc.so]
  then(lld): [libc.so.6]
  count(mold): 4 (NEEDED)
  has(mold): [libna.so]
  then(mold): [libnb.so]
  then(mold): [libnc.so]
  then(mold): [libc.so.6]
run(bfd,mortar) s-named-off
  stdout: nc nx nb na main
run(lld) s-named-off
  stdout: nc nb nx na main
run(mold) s-named-off
  stdout: nc nb na main

# s_named_on: the same script named under --as-needed: not needed.
link gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so -Wl,--no-as-needed libnb.so -Wl,--as-needed s_x.so -Wl,--no-as-needed libnc.so -o s-named-on
check readelf -dW s-named-on
  count: 4 (NEEDED)
  has: [libna.so]
  then: [libnb.so]
  then: [libnc.so]
  then: [libc.so.6]
run s-named-on
  stdout: nc nb na main

# s_push_on: named after --push-state --as-needed: not needed.
link gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so -Wl,--no-as-needed libnb.so -Wl,--push-state,--as-needed s_x.so -Wl,--pop-state libnc.so -o s-push-on
check readelf -dW s-push-on
  count: 4 (NEEDED)
  has: [libna.so]
  then: [libnb.so]
  then: [libnc.so]
  then: [libc.so.6]
run s-push-on
  stdout: nc nb na main

# s_push_off: named after --push-state --no-as-needed: needed there.
link gcc -pie main0.o -Wl,--as-needed libna.so libnx.so libnb.so -Wl,--push-state,--no-as-needed s_x.so -Wl,--pop-state libnc.so -o s-push-off
check readelf -dW s-push-off
  count(bfd,lld,mortar): 2 (NEEDED)
  has(bfd,lld,mortar): [libnx.so]
  then(bfd,lld,mortar): [libc.so.6]
  count(mold): 1 (NEEDED)
  has(mold): [libc.so.6]
run(bfd,lld,mortar) s-push-off
  stdout: nx main
run(mold) s-push-off
  stdout: main

# s_push_pop_restores: --pop-state restores --as-needed before the script.
link gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so -Wl,--push-state,--no-as-needed libnb.so -Wl,--pop-state s_x.so -Wl,--no-as-needed libnc.so -o s-push-pop-restores
check readelf -dW s-push-pop-restores
  count: 4 (NEEDED)
  has: [libna.so]
  then: [libnb.so]
  then: [libnc.so]
  then: [libc.so.6]
run s-push-pop-restores
  stdout: nc nb na main

