  then(bfd,mortar): [libnb.so]
  then(bfd,mortar): [libnx.so]
  then(bfd,mortar): [libnc.so]
  then(bfd,mortar): [libc.so.6]
  count(lld,mold): 5 (NEEDED)
  has(lld,mold): [libna.so]
  then(lld,mold): [libnx.so]
  then(lld,mold): [libnb.so]
  then(lld,mold): [libnc.so]
  then(lld,mold): [libc.so.6]
run(bfd,mortar) cli-group-nested
  stdout: nc nx nb na main
run(lld,mold) cli-group-nested
  stdout: nc nb nx na main

# nested_group_none (the base refused it): a nested script in no group,
# the reference after every mention. GNU ld refuses (undefined reference);
# mortar keeps libnx.so at its first mention (D-19a's fallback), as lld
# and mold write it.
link(bfd) gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so -Wl,--no-as-needed libnb.so -Wl,--as-needed n_sx.so -Wl,--no-as-needed use_x.o libnc.so -o nested-group-none
  exit: fail
  diag: undefined reference to `f_nx'
link(lld,mold,mortar) gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so -Wl,--no-as-needed libnb.so -Wl,--as-needed n_sx.so -Wl,--no-as-needed use_x.o libnc.so -o nested-group-none
check(lld,mold,mortar) readelf -dW nested-group-none
  count(lld,mold,mortar): 5 (NEEDED)
  has(lld,mold,mortar): [libna.so]
  then(lld,mold,mortar): [libnx.so]
  then(lld,mold,mortar): [libnb.so]
  then(lld,mold,mortar): [libnc.so]
  then(lld,mold,mortar): [libc.so.6]
run(lld,mold,mortar) nested-group-none
  stdout: nc nb nx na main

# input_then_group: INPUT(libnx.so) GROUP(libny.so use_x.o): the INPUT entry
# is in no group. GNU ld refuses; mortar writes the fallback, lld and
# mold's order. (The base took the group of the script's other entries
# and kept libnx.so at the script: a guess, now the entry's own state.)
link(bfd) gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so libny.so -Wl,--no-as-needed libnb.so -Wl,--as-needed ig_mixed.so -Wl,--no-as-needed libnc.so -o input-then-group
  exit: fail
  diag: undefined reference to `f_nx'
link(lld,mold,mortar) gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so libny.so -Wl,--no-as-needed libnb.so -Wl,--as-needed ig_mixed.so -Wl,--no-as-needed libnc.so -o input-then-group
check(lld,mold,mortar) readelf -dW input-then-group
  count(lld,mold,mortar): 5 (NEEDED)
  has(lld,mold,mortar): [libna.so]
  then(lld,mold,mortar): [libnx.so]
  then(lld,mold,mortar): [libnb.so]
  then(lld,mold,mortar): [libnc.so]
  then(lld,mold,mortar): [libc.so.6]
run(lld,mold,mortar) input-then-group
  stdout: nc nb nx na main

# dup_run: libdx.so and libdy.so both define who_dup; main_w.o calls it
# after the as-needed libdx.so, then INPUT(libdx.so) plain: GNU ld keeps
# libdx.so at the script, after libdy.so, and the program binds libdy's
# who_dup; lld and mold write libdx.so first and it binds libdx's.
link gcc -pie -Wl,--as-needed libdx.so -Wl,--no-as-needed libdy.so main_w.o s_dx.so -o dup-run
check readelf -dW dup-run
  count(bfd,mortar): 3 (NEEDED)
  has(bfd,mortar): [libdy.so]
  then(bfd,mortar): [libdx.so]
  then(bfd,mortar): [libc.so.6]
  count(lld,mold): 3 (NEEDED)
  has(lld,mold): [libdx.so]
  then(lld,mold): [libdy.so]
  then(lld,mold): [libc.so.6]
run(bfd,mortar) dup-run
  stdout: dx dy main dy
run(lld,mold) dup-run
  stdout: dy dx main dx

# dup_run_on: the script named --as-needed. GNU ld leaves libdx.so out
# (it decided neededness by its binding); mortar keeps it needed by
# first mention (D-11, the deliberate superset of needed-order-dup-def
# line 1), placed after libdy.so: the same binding and run as GNU ld.
link gcc -pie -Wl,--as-needed libdx.so -Wl,--no-as-needed libdy.so main_w.o -Wl,--as-needed s_dx.so -o dup-run-on
check readelf -dW dup-run-on
  count(bfd): 2 (NEEDED)
  has(bfd): [libdy.so]
  then(bfd): [libc.so.6]
  count(lld,mold): 3 (NEEDED)
  has(lld,mold): [libdx.so]
  then(lld,mold): [libdy.so]
  then(lld,mold): [libc.so.6]
  count(mortar): 3 (NEEDED)
  has(mortar): [libdy.so]
  then(mortar): [libdx.so]
  then(mortar): [libc.so.6]
run(bfd) dup-run-on
  stdout: dy main dy
run(lld,mold) dup-run-on
  stdout: dy dx main dx
run(mortar) dup-run-on
  stdout: dx dy main dy

#--- use_x.c
int f_nx(void);
int use_x(void) { return f_nx(); }
#--- who.c
#include <stdio.h>
#define STR2(x) #x
#define STR(x) STR2(x)
__attribute__((constructor)) static void ctor(void) { printf(STR(N) " "); }
const char *who_dup(void) { return STR(N); }
#--- mw.c
#include <stdio.h>
const char *who_dup(void);
int main(void) {
  printf("main %s\n", who_dup());
  return 0;
}
#--- s_x.so
INPUT ( libnx.so )
#--- s_dx.so
INPUT ( libdx.so )
#--- s_anx.so
INPUT ( AS_NEEDED ( libnx.so ) )
#--- g_x.so
GROUP ( libnx.so )
#--- s_yx.so
INPUT ( libny.so libnx.so )
#--- s_anyx.so
INPUT ( AS_NEEDED ( libny.so ) libnx.so )
#--- n_sx.so
INPUT ( s_x.so )
#--- n_asx.so
INPUT ( AS_NEEDED ( s_x.so ) )
#--- n_sanx.so
INPUT ( s_anx.so )
#--- s_lx.so
INPUT ( -lnx )
#--- s_alx.so
INPUT ( AS_NEEDED ( -lnx ) )
#--- ig_mixed.so
INPUT ( libnx.so ) GROUP ( libny.so use_x.o )
