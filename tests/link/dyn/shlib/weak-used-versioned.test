# dyn.md D-27 (WP-141), the D-10 setting's `bind(k)`, D-12: in an
# executable, a weak-only reference whose only definition is a VERSIONED
# one (`vfn@@V1`, `vdat@@V1`) in `libv.so`, which `--as-needed` drops
# but `libm2.so` (needed: `m2fn`) lists, so `libv.so` is used (U), not
# needed. The key stays bound in `libv.so` (its type, PLT/GOT form, copy
# and canonical PLT follow the binding) and its `.dynsym` entry is
# written unversioned (version index 1): no `DT_NEEDED` of `libv.so`, no
# `Verneed` of it. GNU ld's image; before WP-141 mortar refused the line
# by name (`versioned reference to vfn bound in a shared object that is
# not needed`). Four forms of the reference, `-pie` (`-fPIE` objects) and
# `-no-pie` (`-fno-pie` objects): `call` (`vfn()`), `addr` (`hp = vfn` in
# data), `cmp` (`if (vfn) vfn()`), `dat` (`&vdat ? vdat : -1`). Each
# runs with `libv.so` (loaded through `libm2.so`: 27, 25) and, but `call`,
# with `alt/libv.so`, whose `V1` lacks `vfn` and `vdat` (20, 19).
#
# The hazard (D-27, by measurement): on x86-64, non-PIC `-no-pie` `cmp`
# takes a canonical PLT and `dat` a `R_X86_64_COPY` from the used
# `libv.so` (GNU ld's image, and mortar's for an unversioned definition
# before WP-141). With `alt/libv.so` the PLT address makes `if (vfn)`
# true and the call crashes, and the copy stops the load (`symbol lookup
# error`, status 127): the known hazard of a weak reference from non-PIC
# code, the same with a NEEDED library (`weak-used-versioned-needed`).
#
# Where the references differ (D-27's table): lld leaves such a key
# unbound in `-no-pie` (no record: `addr` prints 20 and, on x86-64,
# `cmp`/`dat` print 20/19 even with `libv.so` loaded; the verifier, which
# binds the key as D-10 does, finds R2 on its x86-64 `cmp-nopie`, so lld
# is skipped on x86-64); mold keeps
# `libv.so` needed and the version (`vfn@V1`). mortar's own relocation
# forms (as for a needed library): on x86-64 `-pie`, `cmp` has a
# `JUMP_SLOT` where GNU ld uses `.plt.got`. `addr` in `-no-pie` is
# `weak-used-versioned-addr` (the verifier's findings on GNU ld's and
# lld's outputs).
#@ spec: dyn.md "D-27"
#@ arch: aarch64 x86_64
#@ skip(lld,x86_64): the verifier's R2 on lld's -no-pie `cmp` (the key left unbound: an absolute word of 0 where D-10 binds it; WP-141)

cc -O1 -fPIC v.c -o v.o
cc -O1 -fPIC vx.c -o vx.o
cc -O1 -fPIC m2.c -o m2.o
cc -O1 -fPIE call.c -o call-pie.o
cc -O1 -fPIE addr.c -o addr-pie.o
cc -O1 -fPIE cmp.c -o cmp-pie.o
cc -O1 -fPIE dat.c -o dat-pie.o
cc -O1 -fno-pie call.c -o call-nopie.o
cc -O1 -fno-pie cmp.c -o cmp-nopie.o
cc -O1 -fno-pie dat.c -o dat-nopie.o
shlib gcc v.o -Wl,--version-script=v.map -Wl,-soname,libv.so -o libv.so
shlib gcc vx.o -Wl,--version-script=vx.map -Wl,-soname,libv.so -o alt/libv.so
shlib gcc m2.o -Wl,-soname,libm2.so -L. -Wl,--no-as-needed -lv -o libm2.so

# ---- -pie ------------------------------------------------------------------
link gcc -pie call-pie.o -L. -Wl,--as-needed -lv -lm2 -o call-pie
run call-pie
  stdout: 27
check(bfd,lld,mortar) readelf -dW call-pie
  has: (NEEDED) Shared library: [libm2.so]
  not: [libv.so]
check(bfd,lld,mortar) readelf -W --dyn-syms call-pie
  has: 0000000000000000 * FUNC WEAK DEFAULT UND vfn$
check(bfd,lld,mortar) readelf -VW call-pie
  not: File: libv.so
check(mortar) readelf -rW call-pie
  has: _JUMP_SLOT * vfn + 0
check(mold) readelf -dW call-pie
  has: (NEEDED) Shared library: [libv.so]

link gcc -pie addr-pie.o -L. -Wl,--as-needed -lv -lm2 -o addr-pie
run addr-pie
  stdout: 27
run addr-pie
  env: LD_LIBRARY_PATH=alt:.
  stdout: 20
check(bfd,lld,mortar) readelf -W --dyn-syms addr-pie
  has: 0000000000000000 * FUNC WEAK DEFAULT UND vfn$
check(bfd,lld,mortar) readelf -dW addr-pie
  not: [libv.so]
check(bfd,lld,mortar) readelf -VW addr-pie
  not: File: libv.so

link gcc -pie cmp-pie.o -L. -Wl,--as-needed -lv -lm2 -o cmp-pie
run cmp-pie
  stdout: 27
run cmp-pie
  env: LD_LIBRARY_PATH=alt:.
  stdout: 20
check(bfd,lld,mortar) readelf -W --dyn-syms cmp-pie
  has: 0000000000000000 * FUNC WEAK DEFAULT UND vfn$
check(bfd,lld,mortar) readelf -dW cmp-pie
  not: [libv.so]
check(bfd,lld,mortar) readelf -VW cmp-pie
  not: File: libv.so
check(mortar) readelf -rW cmp-pie
  has: _GLOB_DAT * vfn + 0

link gcc -pie dat-pie.o -L. -Wl,--as-needed -lv -lm2 -o dat-pie
run dat-pie
  stdout: 25
run dat-pie
  env: LD_LIBRARY_PATH=alt:.
  stdout: 19
check(bfd,lld,mortar) readelf -W --dyn-syms dat-pie
  has: 0000000000000000 * OBJECT WEAK DEFAULT UND vdat$
check(bfd,lld,mortar) readelf -dW dat-pie
  not: [libv.so]
check(bfd,lld,mortar) readelf -VW dat-pie
  not: File: libv.so
check(mortar) readelf -rW dat-pie
  has: _GLOB_DAT * vdat + 0

# ---- -no-pie ---------------------------------------------------------------
link gcc -no-pie call-nopie.o -L. -Wl,--as-needed -lv -lm2 -o call-nopie
run call-nopie
  stdout: 27
check(bfd,lld,mortar) readelf -W --dyn-syms call-nopie
  has: 0000000000000000 * FUNC WEAK DEFAULT UND vfn$
check(bfd,lld,mortar) readelf -dW call-nopie
  not: [libv.so]
check(bfd,lld,mortar) readelf -VW call-nopie
  not: File: libv.so

link gcc -no-pie cmp-nopie.o -L. -Wl,--as-needed -lv -lm2 -o cmp-nopie
run(bfd,mold,mortar) cmp-nopie
  stdout: 27
run(lld,aarch64) cmp-nopie
  stdout: 27
run(aarch64) cmp-nopie
  env: LD_LIBRARY_PATH=alt:.
  stdout: 20
# The hazard: the canonical PLT makes `vfn` non-null; `alt` lacks it.
run(bfd,mold,mortar,x86_64) cmp-nopie
  env: LD_LIBRARY_PATH=alt:.
  exit: signal 11
check(bfd,lld,mortar) readelf -dW cmp-nopie
  not: [libv.so]
check(bfd,lld,mortar) readelf -VW cmp-nopie
  not: File: libv.so
check(bfd,mortar,x86_64) readelf -W --dyn-syms cmp-nopie
  has: FUNC WEAK DEFAULT UND vfn$
  not: 0000000000000000 * UND vfn$
check(bfd,lld,mortar,aarch64) readelf -W --dyn-syms cmp-nopie
  has: 0000000000000000 * FUNC WEAK DEFAULT UND vfn$

link gcc -no-pie dat-nopie.o -L. -Wl,--as-needed -lv -lm2 -o dat-nopie
run(bfd,mold,mortar) dat-nopie
  stdout: 25
run(lld,aarch64) dat-nopie
  stdout: 25
run(aarch64) dat-nopie
  env: LD_LIBRARY_PATH=alt:.
  stdout: 19
# The hazard: a copy from `libv.so`, whose `alt` lacks `vdat`: the
# loader refuses the program (`symbol lookup error`).
run(bfd,mortar,x86_64) dat-nopie
  env: LD_LIBRARY_PATH=alt:.
  exit: 127
run(mold,x86_64) dat-nopie
  env: LD_LIBRARY_PATH=alt:.
  stdout: 20
check(bfd,lld,mortar) readelf -dW dat-nopie
  not: [libv.so]
check(bfd,lld,mortar) readelf -VW dat-nopie
  not: File: libv.so
check(bfd,mortar,x86_64) readelf -rW dat-nopie
  has: R_X86_64_COPY * vdat + 0
check(bfd,mortar,x86_64) readelf -W --dyn-syms dat-nopie
  has: OBJECT GLOBAL DEFAULT * vdat$
check(bfd,lld,mortar,aarch64) readelf -W --dyn-syms dat-nopie
  has: 0000000000000000 * OBJECT WEAK DEFAULT UND vdat$

#--- alt/README
alt/libv.so: libv.so's version V1 without vfn and vdat.
#--- v.map
V1 { global: vfn; vdat; local: *; };
#--- vx.map
V1 { global: vother; local: *; };
#--- v.c
int vfn(void) { return 7; }
int vdat = 5;
#--- vx.c
int vother(void) { return 1; }
#--- m2.c
int m2fn(void) { return 20; }
#--- call.c
#include <stdio.h>
int vfn(void) __attribute__((weak));
int m2fn(void);
int main(void) { printf("%d\n", vfn() + m2fn()); return 0; }
#--- addr.c
#include <stdio.h>
int vfn(void) __attribute__((weak));
int m2fn(void);
int (*hp)(void) = vfn;
int main(void) { printf("%d\n", (hp ? hp() : 0) + m2fn()); return 0; }
#--- cmp.c
#include <stdio.h>
int vfn(void) __attribute__((weak));
int m2fn(void);
int main(void) { printf("%d\n", (vfn ? vfn() : 0) + m2fn()); return 0; }
#--- dat.c
#include <stdio.h>
extern int vdat __attribute__((weak));
int m2fn(void);
int main(void) { printf("%d\n", (&vdat ? vdat : -1) + m2fn()); return 0; }
