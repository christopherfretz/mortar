# PENDING (WP-172): the verifier's P-D6 judges GNU ld's own list wrong on this line ("DT_NEEDED order is [libna.so, libnb.so, libnx.so, libnc.so, libc.so.6]; D-19a gives [libna.so, libnx.so, libnb.so, libnc.so, libc.so.6]": it does not count an object in a script's own GROUP as a reason for a mention again inside that GROUP, directly or through a nested script: the same finding on all three lines here); the verifier package that follows WP-172 renames this file to .test.
# dyn.md D-19a (WP-172): a script GROUP holding an object that
# references f_nx and a mention again of libnx.so (first named
# as-needed and unreferenced on the command line), directly
# (GROUP(AS_NEEDED(libnx.so) use_x.o)) or through a nested script
# (GROUP(s_x.so use_x.o), GROUP(s_anx.so use_x.o)): the object in the same
# group is a reason, so libnx.so is kept at the script, after libnb.so
# (GNU ld and mortar; lld and mold write it at its first mention; mold
# cannot read AS_NEEDED inside a nested script). Measured with
# GNU ld 2.44, lld 19 and mold 2.37.1 on AArch64 and x86-64 (identical
# lists; spec/landed/dyn/WP-172.md section 2). Each program prints its
# constructors (the reverse of the loader's order) and "main"; fixture
# needed-libs.
#@ spec: dyn.md "D-19a"
#@ arch: aarch64 x86_64
#@ fixture: needed-libs

cc -O1 -fPIE use_x.c -o use_x.o

link gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so -Wl,--no-as-needed libnb.so g_anx_obj.so libnc.so -o g-anx-obj
check readelf -dW g-anx-obj
  count(bfd,mortar): 5 (NEEDED)
  has(bfd,mortar): [libna.so]
  then(bfd,mortar): [libnb.so]
  then(bfd,mortar): [libnx.so]
  then(bfd,mortar): [libnc.so]
  then(bfd,mortar): [libc.so.6]
  count(lld,mold): 5 (NEEDED)
  has(lld,mold): [libna.so]
  then(lld,mold): [libnx.so]
  then(lld,mold): [libnb.so]
  then(lld,mold): [libnc.so]
  then(lld,mold): [libc.so.6]
run(bfd,mortar) g-anx-obj
  stdout: nc nx nb na main
run(lld,mold) g-anx-obj
  stdout: nc nb nx na main


# nested_group (the base refused it): GROUP(s_x.so use_x.o) named
# --as-needed: the nested entry is in the group of use_x.o.
link gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so -Wl,--no-as-needed libnb.so -Wl,--as-needed g_sx_use.so -Wl,--no-as-needed libnc.so -o nested-group
check readelf -dW nested-group
  count(bfd,mortar): 5 (NEEDED)
  has(bfd,mortar): [libna.so]
  then(bfd,mortar): [libnb.so]
  then(bfd,mortar): [libnx.so]
  then(bfd,mortar): [libnc.so]
  then(bfd,mortar): [libc.so.6]
  count(lld,mold): 5 (NEEDED)
  has(lld,mold): [libna.so]
  then(lld,mold): [libnx.so]
  then(lld,mold): [libnb.so]
  then(lld,mold): [libnc.so]
  then(lld,mold): [libc.so.6]
run(bfd,mortar) nested-group
  stdout: nc nx nb na main
run(lld,mold) nested-group
  stdout: nc nb nx na main

# nested_group_asn (the base refused it): GROUP(s_anx.so use_x.o).
link(bfd,lld,mortar) gcc -pie main0.o -Wl,--no-as-needed libna.so -Wl,--as-needed libnx.so -Wl,--no-as-needed libnb.so g_sanx_use.so libnc.so -o nested-group-asn
check(bfd,lld,mortar) readelf -dW nested-group-asn
  count(bfd,mortar): 5 (NEEDED)
  has(bfd,mortar): [libna.so]
  then(bfd,mortar): [libnb.so]
  then(bfd,mortar): [libnx.so]
  then(bfd,mortar): [libnc.so]
  then(bfd,mortar): [libc.so.6]
  count(lld): 5 (NEEDED)
  has(lld): [libna.so]
  then(lld): [libnx.so]
  then(lld): [libnb.so]
  then(lld): [libnc.so]
  then(lld): [libc.so.6]
run(bfd,mortar) nested-group-asn
  stdout: nc nx nb na main
run(lld) nested-group-asn
  stdout: nc nb nx na main
#--- use_x.c
int f_nx(void);
int use_x(void) { return f_nx(); }
#--- g_anx_obj.so
GROUP ( AS_NEEDED ( libnx.so ) use_x.o )
#--- s_x.so
INPUT ( libnx.so )
#--- s_anx.so
INPUT ( AS_NEEDED ( libnx.so ) )
#--- g_sx_use.so
GROUP ( s_x.so use_x.o )
#--- g_sanx_use.so
GROUP ( s_anx.so use_x.o )
