# dyn.md D-114, D-115 (WP-125), resolve.md §9.7 rule 12: `foo@V1` and
# `foo@@V2` by `.symver` in one library. The first library (`libold.so`,
# soname `libs.so.1`) exports `foo@@V1`; `prog1` links against it. The
# second (`libs.so.1`, the same soname) keeps the old `foo` as the hidden
# `foo@V1` and adds the default `foo@@V2`; `prog2` links against it. Both
# programs run against the second library and each gets its version.
# Without a script naming the versions every linker refuses the library
# (mortar: `undefined-version`, rule 12).
#@ spec: dyn.md "D-114"; dyn.md "D-115"; resolve.md "9.7"
#@ arch: aarch64 x86_64
#@ xfail(mortar): M4: WP-149: the verifier's P-D7 'a name twice in .dynsym' on libs.so.1, whose two entries are foo@V1 (hidden) and foo@@V2 as GNU ld's (bytes checked at the merge); runs right with --no-plumb

cc -O1 -fPIC old.c -o old.o
cc -O1 -fPIC sv.c -o sv.o
cc -O1 -fPIE main.c -o main.o
link gcc -shared old.o -Wl,--version-script,v1.map -Wl,-soname,libs.so.1 -o libold.so
check readelf --dyn-syms -W libold.so
  has: FUNC GLOBAL DEFAULT * foo@@V1$
link gcc -shared sv.o -Wl,--version-script,v2.map -Wl,-soname,libs.so.1 -o libs.so.1
check readelf --dyn-syms -W libs.so.1
  has: FUNC GLOBAL DEFAULT * foo@V1$
  has: FUNC GLOBAL DEFAULT * foo@@V2$
  not: foo_v
check readelf -VW libs.so.1
  has: 2h(V1)
check(bfd,mortar) readelf -VW libs.so.1
  has: Index: 3 Cnt: 2 Name: V2
  then: Parent 1: V1
link gcc -shared sv.o -o libnone.so
  exit: fail
  diag(bfd): version node not found for symbol foo@V1
  diag(lld): symbol foo@V1 has undefined version V1
  diag(mold): symbol foo has undefined version V1
  diag(mortar): error: sv.o: version V1 of foo is not defined
  diag(mortar): error: sv.o: version V2 of foo is not defined
host gcc -pie main.o -L. -l:libold.so -o prog1
check readelf --dyn-syms -W prog1
  has: UND foo@V1
host gcc -pie main.o -L. -l:libs.so.1 -o prog2
check readelf --dyn-syms -W prog2
  has: UND foo@V2
run prog1
  stdout: foo 1
run prog2
  stdout: foo 2

#--- old.c
int foo(void) { return 1; }
#--- sv.c
__asm__(".symver foo_v1, foo@V1");
__asm__(".symver foo_v2, foo@@V2");
int foo_v1(void) { return 1; }
int foo_v2(void) { return 2; }
#--- v1.map
V1 { global: foo; local: *; };
#--- v2.map
V1 { global: foo; local: *; };
V2 { global: foo; } V1;
#--- main.c
#include <stdio.h>
int foo(void);
int main(void) { printf("foo %d\n", foo()); return 0; }
