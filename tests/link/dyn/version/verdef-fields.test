# dyn.md D-115, D-116 (WP-125): `.gnu.version_d` field by field against
# GNU ld. Three nodes, the last with two parents, and no `-soname`: the
# base is named by the output's basename. Every `Verdef` (version, flags,
# index, hash, name, its parents) is GNU ld's: GNU ld writes a node's
# parents last-written first (`VERS_C { … } VERS_A VERS_B;` lists VERS_B
# then VERS_A; measured, WP-125), and so does mortar. lld and mold refuse
# a node with two parents (`; expected`), so they do not link it here
# (`parents.test` has their one-parent output). The section header:
# `SHT_GNU_verdef`, `A`, linked to `.dynstr`, `sh_info` the count (4);
# mortar aligns it to 4 (lld, mold; GNU ld 8).
#@ spec: dyn.md "D-115"; dyn.md "D-116"
#@ arch: aarch64 x86_64
#@ requires: llvm-readelf

cc -O1 -fPIC f.c -o f.o
link(bfd,mortar) gcc -shared f.o -Wl,--version-script,f.map -o libfields.so
check(bfd,mortar) llvm-readelf --elf-output-style=LLVM -V libfields.so
  has: ^VersionDefinitions [$
  then: Flags [ (0x1)
  then: Base (0x1)
  then: Index: 1$
  then: Hash: 218425711$
  then: Name: libfields.so$
  then: Predecessors: []$
  then: Flags [ (0x0)
  then: Index: 2$
  then: Hash: 95058225$
  then: Name: VERS_A$
  then: Predecessors: []$
  then: Index: 3$
  then: Hash: 95058226$
  then: Name: VERS_B$
  then: Predecessors: [VERS_A]$
  then: Index: 4$
  then: Hash: 95058227$
  then: Name: VERS_C$
  then: Predecessors: [VERS_B, VERS_A]$
check readelf -SW libfields.so
  has: .gnu.version_d VERDEF
  not: .gnu.version_r
check(mortar) readelf -SW libfields.so
  has: .gnu.version_d VERDEF * A 4 4 4$
check readelf -VW libfields.so
  has: Version definition section '.gnu.version_d' contains 4 entries
check readelf --dyn-syms -W libfields.so
  has: FUNC GLOBAL DEFAULT * a@@VERS_A$
  has: FUNC GLOBAL DEFAULT * b@@VERS_B$
  has: FUNC GLOBAL DEFAULT * c@@VERS_C$
  not: DEFAULT * d$

#--- f.c
int a(void) { return 1; }
int b(void) { return 2; }
int c(void) { return 3; }
int d(void) { return 4; }
#--- f.map
VERS_A { global: a; };
VERS_B { global: b; } VERS_A;
VERS_C { global: c; local: *; } VERS_A VERS_B;
