# dyn.md §2.1, end to end: clang's default link line (clang 22, as users
# link): a C hello compiled by clang the default way and linked by `clang`
# with no option (the default PIE: `-pie` after `-dynamic-linker`,
# `-lgcc --as-needed -lgcc_s --no-as-needed -lc`, `Scrt1.o`, `crtbeginS.o`
# of the GCC installation) and with `-no-pie` (`crt1.o`, `crtbegin.o`),
# each run. Needed: `libc.so.6` only (§2.2).
#@ spec: dyn.md "2.1 Default link lines"
#@ spec: dyn.md "D-1"
#@ arch: aarch64 x86_64
#@ requires: clang

cc(clang) -O2 hello.c -o hello.o
link clang hello.o -o pie
run pie
  stdout: hello C, 42
link clang -no-pie hello.o -o exec
run exec
  stdout: hello C, 42
check readelf -hdW pie
  has: Type: DYN
  has: (FLAGS_1) Flags: PIE
  has: (NEEDED) Shared library: [libc.so.6]
  count: 1 (NEEDED)
check readelf -hdW exec
  has: Type: EXEC
  has: (NEEDED) Shared library: [libc.so.6]
  count: 1 (NEEDED)

#--- hello.c
#include <stdio.h>
#include <stdlib.h>

static int answer;
static void bye(void) { printf("hello C, %d\n", answer); }

int main(void) {
  atexit(bye);
  answer = 42;
  return 0;
}
