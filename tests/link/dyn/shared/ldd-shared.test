# dyn.md D-125, D-71 (WP-123): the loader's `--list` (what `ldd` runs)
# lists the needed objects of a mortar library and of a host that needs
# it; nothing is "not found".
#@ spec: dyn.md "D-125"
#@ arch: aarch64 x86_64
#@ xfail(mortar,x86_64): M4: WP-127 (x86-64 shared objects; dyn.md D-100)

cc -O1 -fPIC lib.c -o lib.o
cc -O1 -fPIE main.c -o main.o
link gcc -shared lib.o -Wl,-soname,libld.so -o libld.so
host gcc -pie main.o -L. -lld -o prog
check ldd prog
  has: libld.so => */libld.so (0x
  has: libc.so.6 => */libc.so.6 (0x
  not: not found
run prog
  stdout: 42

#--- lib.c
int lib_add(int a, int b) {
  int sum = a + b;
  int twice = sum * 2;
  return twice - sum;
}
#--- main.c
#include <stdio.h>
int lib_add(int, int);
int main(void) { printf("%d\n", lib_add(20, 22)); return 0; }
