# dyn.md D-117 "before the start" (the analysis's case of
# `shared-pic-before-start`, WP-119; measured by WP-115 on
# tests/shared-design/sup/c.c): Clang -O0 -fPIC compiles `tab - 1`, the
# 1-based idiom, as the address of `.data + 0x18` (`tab`) minus 8, which
# is `.data + 0x10`, the start of the exported `gcount`. The analysis
# cannot tell it from a bound use of `gcount`: mortar refuses it, with
# the boundary's remedy note and "do not form an address before an
# object". At -O2 the address is formed exactly and every linker links.
#@ spec: dyn.md "D-117"
#@ arch: aarch64
#@ requires: clang

cc(clang) -O0 -fPIC c.c -o c0.o
cc(clang) -O2 -fPIC c.c -o c2.o
link gcc -shared c2.o -Wl,-soname,libc2.so -o libc2.so
link(mortar) gcc -shared c0.o -Wl,-soname,libc0.so -o libc0.so
  exit: fail
  diag: relocation R_AARCH64_ADD_ABS_LO12_NC against symbol `gcount' which may bind externally can not be used when making a shared object
  diag: >>> the address .data+0x10 is computed by the instruction at f+0x14
  diag: >>> compile with -fdata-sections (each object in its own section), and do not form an address before an object

#--- c.c
int gvar[4] = {1,2,3,4};
static double tab[8] = {1,2,3,4,5,6,7,8};
int gcount = 7;
static int w[5] = {1,2,3,4,5};
double f(int n){ double r=0; double *p = tab - 1; for(int i=1;i<=n;i++){ p[i] = p[i]*2+gvar[0]; r+=p[i]; } return r; }
int g(int i){ return w[i-1] + w[i-2] + gcount; }
int h(int i,int j){ return w[i-j-3]; }
