# resolve.md §4.2, dyn.md D-11 item 2 (WP-152): -u K (and -e K) where
# only an --as-needed library defines K and nothing else needs it: the
# library is not needed and K is written nowhere (GNU ld, lld, mortar;
# GNU ld keeps an undefined .symtab entry; mold makes the library needed,
# not linked here). -e K is then an undefined entry: entry-not-found
# (GNU ld warns too). mortar's needed set and .dynsym equal GNU ld's.
# The verifier still reads a root as a strong reference from file 0
# (P-D6: "DT_NEEDED lacks libks.so"), so the three linkers are xfail
# until it follows D-11 item 2; mortar's -e executables also meet P-D4
# (e_entry 0, resolve.md §5.5). lld on root-as-needed's refused line
# (the library first, nothing needing it, then the member): the library
# not needed, nothing extracted, k_fn nowhere. mold has no step: it makes the library
# needed and the verifier's P-D7 judges that.
#@ spec: resolve.md §4.2
#@ spec: dyn.md "D-11"
#@ arch: aarch64 x86_64
#@ xfail(bfd,lld): P-D6 reads a -u root as a reference that makes an --as-needed library needed (WP-152 rule: it does not)
#@ xfail(mortar): P-D6 reads a -u root as a reference that makes an --as-needed library needed (WP-152 rule: it does not); P-D4 e_entry 0 after entry-not-found (WP-163)

cc -O1 -fPIC ks.c -o ks.o
cc -O1 -fPIC ka.c -o ka.o
cc -O1 -fPIC r.c -o r.o
cc -O1 -fPIC rk.c -o rk.o
cc -O1 -fPIE m0.c -o m0.o
ar rcs libka.a ka.o
shlib gcc ks.o -o libks.so
link(bfd,lld,mortar) gcc -pie m0.o -u k_fn -L. -Wl,--as-needed -lks -Wl,--no-as-needed -o u-pie
run(bfd,lld,mortar) u-pie
check(bfd,lld,mortar) readelf -dW u-pie
  not: libks.so
check(bfd,lld,mortar) readelf --dyn-syms -W u-pie
  not: * k_fn$
check(lld,mortar) readelf -sW u-pie
  not: * k_fn$
link(bfd,mortar) gcc -pie m0.o -Wl,-e,k_fn -L. -Wl,--as-needed -lks -Wl,--no-as-needed -o entry-pie
  diag: cannot find entry symbol k_fn
check(bfd,mortar) readelf -dW entry-pie
  not: libks.so
check(bfd,mortar) readelf --dyn-syms -W entry-pie
  not: * k_fn$
link(lld) gcc -pie m0.o -u k_fn -L. -Wl,--as-needed -lks -Wl,--no-as-needed libka.a -o reflld-pie
check(lld) readelf -dW reflld-pie
  not: libks.so
check(lld) readelf -sW reflld-pie
  not: * k_fn$
link(bfd,lld,mortar) gcc -no-pie m0.o -u k_fn -L. -Wl,--as-needed -lks -Wl,--no-as-needed -o u-nopie
run(bfd,lld,mortar) u-nopie
check(bfd,lld,mortar) readelf -dW u-nopie
  not: libks.so
check(bfd,lld,mortar) readelf --dyn-syms -W u-nopie
  not: * k_fn$
check(lld,mortar) readelf -sW u-nopie
  not: * k_fn$
link(bfd,mortar) gcc -no-pie m0.o -Wl,-e,k_fn -L. -Wl,--as-needed -lks -Wl,--no-as-needed -o entry-nopie
  diag: cannot find entry symbol k_fn
check(bfd,mortar) readelf -dW entry-nopie
  not: libks.so
check(bfd,mortar) readelf --dyn-syms -W entry-nopie
  not: * k_fn$
link(lld) gcc -no-pie m0.o -u k_fn -L. -Wl,--as-needed -lks -Wl,--no-as-needed libka.a -o reflld-nopie
check(lld) readelf -dW reflld-nopie
  not: libks.so
check(lld) readelf -sW reflld-nopie
  not: * k_fn$
link(bfd,lld,mortar) gcc -shared -u k_fn -L. -Wl,--as-needed -lks -Wl,--no-as-needed -o u-so.so
check(bfd,lld,mortar) readelf -dW u-so.so
  not: libks.so
check(bfd,lld,mortar) readelf --dyn-syms -W u-so.so
  not: * k_fn$
check(lld,mortar) readelf -sW u-so.so
  not: * k_fn$
link(bfd,mortar) gcc -shared -Wl,-e,k_fn -L. -Wl,--as-needed -lks -Wl,--no-as-needed -o entry-so.so
check(bfd,mortar) readelf -dW entry-so.so
  not: libks.so
check(bfd,mortar) readelf --dyn-syms -W entry-so.so
  not: * k_fn$
link(lld) gcc -shared -u k_fn -L. -Wl,--as-needed -lks -Wl,--no-as-needed libka.a -o reflld-so.so
check(lld) readelf -dW reflld-so.so
  not: libks.so
check(lld) readelf -sW reflld-so.so
  not: * k_fn$

#--- ks.c
int k_fn(void) { return 5; }
int k_other(void) { return 6; }
#--- ka.c
int k_fn(void) { return 7; }
#--- r.c
int k_other(void);
int use_other(void) { return k_other(); }
#--- rk.c
int k_fn(void);
int use_k(void) { return k_fn(); }
#--- m0.c
int main(void) { return 0; }
#--- ext.ld
EXTERN(k_fn)
