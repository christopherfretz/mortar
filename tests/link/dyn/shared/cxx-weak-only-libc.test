# dyn.md D-11, D-111, D-27 (WP-123): a C++ library that references the C
# library only weakly (crtbeginS's `__cxa_finalize`): under the driver's
# `--as-needed` the C library is not needed, and GNU ld writes
# `__cxa_finalize` as an unversioned WEAK NOTYPE UND entry. mortar binds
# it to the C library's versioned definition and refuses the link by
# name (D-27: a version of a shared object that is not needed). (lld
# writes an unversioned WEAK FUNC UND entry and mold keeps the C library
# needed and binds `__cxa_finalize@GLIBC_2.17`: the checks are GNU ld's.)
#@ spec: dyn.md "D-111"
#@ arch: aarch64 x86_64
#@ requires: g++
#@ xfail(mortar): M4: WP-123 finding F3, the follow-up row "weak undefined versioned reference whose library --as-needed drops, in Shared" (D-27)

cxx -O1 -fPIC lib.cc -o lib.o
cxx -O1 -fPIE main.cc -o main.o
link g++ -shared lib.o -o libwo.so
check(bfd,mortar) readelf -dW libwo.so
  not: [libc.so.6]
check(bfd,mortar) readelf -W --dyn-syms libwo.so
  has: NOTYPE WEAK DEFAULT UND __cxa_finalize$
host g++ -pie main.o -L. -lwo -o prog
run prog
  stdout: caught boom

#--- lib.cc
#include <stdexcept>
int thrower(int x) {
  if (x > 0) throw std::runtime_error("boom");
  return x;
}
#--- main.cc
#include <cstdio>
#include <stdexcept>
int thrower(int);
int main() {
  try { thrower(1); } catch (const std::runtime_error &e) { std::printf("caught %s\n", e.what()); }
  return 0;
}
