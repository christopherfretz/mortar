# dyn.md D-11 (the D-10 setting's `bind(k)` in `Shared`), D-111, D-27
# (WP-137, WP-123's finding F3): a C++ library that references the C
# library only weakly (crtbeginS's `__cxa_finalize`): under the driver's
# `--as-needed` the C library is not needed, and it is dropped although
# `libstdc++.so.6` lists it (a shared object's link searches no
# `DT_NEEDED` entry). GNU ld and mortar write `__cxa_finalize` as an
# unversioned WEAK NOTYPE UND entry and no `.gnu.version_r` need of the C
# library. (lld writes an unversioned WEAK FUNC UND entry and mold keeps
# the C library needed and binds `__cxa_finalize@GLIBC_2.17`: the checks
# are GNU ld's.)
#@ spec: dyn.md "D-111"
#@ arch: aarch64 x86_64
#@ requires: g++

cxx -O1 -fPIC lib.cc -o lib.o
cxx -O1 -fPIE main.cc -o main.o
link g++ -shared lib.o -o libwo.so
check(bfd,mortar) readelf -dW libwo.so
  not: [libc.so.6]
check(bfd,mortar) readelf -W --dyn-syms libwo.so
  has: NOTYPE WEAK DEFAULT UND __cxa_finalize$
check(bfd,mortar) readelf -VW libwo.so
  not: File: libc.so.6
host g++ -pie main.o -L. -lwo -o prog
run prog
  stdout: caught boom

#--- lib.cc
#include <stdexcept>
int thrower(int x) {
  if (x > 0) throw std::runtime_error("boom");
  return x;
}
#--- main.cc
#include <cstdio>
#include <stdexcept>
int thrower(int);
int main() {
  try { thrower(1); } catch (const std::runtime_error &e) { std::printf("caught %s\n", e.what()); }
  return 0;
}
