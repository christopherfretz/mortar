# --wrap=SYM in a shared object (resolve.md §7.1, WP-153): definitions
# keep their names, so the export set holds f and __wrap_f as defined,
# and __real_f is no symbol of its own (its mentions bind to f). An
# undefined f leaves UND f and UND __wrap_f (the object's mentions of f
# bind to __wrap_f, of __real_f to f), which libfo.so defines at run
# time. The binding stays preemptible: an interposer of f reaches
# callreal and, through the f call that is not wrapped (E13: f's own
# object; lld wraps it, callf=101), callf.
#@ spec: resolve.md §7.1
#@ arch: aarch64 x86_64

cc -O0 -fPIC -fno-inline sh.c -o sh.o
cc -O0 -fPIC -fno-inline shu.c -o shu.o
cc -O0 -fPIC fo.c -o fo.o
cc -O0 -fPIC pre.c -o pre.o
cc -O0 -fPIE shm.c -o shm.o
cc -O0 -fPIE shum.c -o shum.o
shlib gcc pre.o -o libpre.so
shlib gcc fo.o -o libfo.so
link gcc -shared sh.o -Wl,--wrap=f -o libsh.so
check readelf --dyn-syms -W libsh.so
  has: FUNC * GLOBAL DEFAULT * f$
  has: FUNC * GLOBAL DEFAULT * __wrap_f$
  has: FUNC * GLOBAL DEFAULT * callf$
  has: FUNC * GLOBAL DEFAULT * callreal$
  not: __real_f
link gcc -shared shu.o -L. -lfo -Wl,--wrap=f -o libshu.so
check readelf --dyn-syms -W libshu.so
  has: GLOBAL DEFAULT UND f$
  has: GLOBAL DEFAULT UND __wrap_f$
  not: __real_f
link gcc -pie shm.o -L. -lsh -Wl,-rpath,. -o prog
run(bfd,mold,mortar) prog
  stdout: callf=1 callreal=1 f=1 wrap=101
run(lld) prog
  stdout: callf=101 callreal=1 f=1 wrap=101
run(bfd,mold,mortar) prog
  env: LD_PRELOAD=./libpre.so
  stdout: callf=9 callreal=9 f=9 wrap=109
run(lld) prog
  env: LD_PRELOAD=./libpre.so
  stdout: callf=109 callreal=9 f=9 wrap=109
link gcc -pie shum.o -L. -lshu -Wl,-rpath,. -o progu
run progu
  stdout: callf=1 callreal=1

#--- sh.c
int f(void) { return 1; }
int __real_f(void);
int __wrap_f(void) { return 100 + __real_f(); }
int callf(void) { return f(); }
int callreal(void) { return __real_f(); }
#--- shu.c
int f(void);
int __real_f(void);
int callf(void) { return f(); }
int callreal(void) { return __real_f(); }
#--- fo.c
int f(void) { return 1; }
int __wrap_f(void) { return f(); }
#--- pre.c
int f(void) { return 9; }
#--- shm.c
#include <stdio.h>
int callf(void); int callreal(void); int f(void); int __wrap_f(void);
int main(void) { printf("callf=%d callreal=%d f=%d wrap=%d\n", callf(), callreal(), f(), __wrap_f()); return 0; }
#--- shum.c
#include <stdio.h>
int callf(void); int callreal(void);
int main(void) { printf("callf=%d callreal=%d\n", callf(), callreal()); return 0; }
