# dyn.md D-117 "Bound use through a register" (the analysis, WP-119):
# W44 of record WP-110 §G.1. GCC -O2 -fPIE code reaches the exported `g`
# from the section anchor of the locals `h1`, `h2` (`.data + 0`) by an
# instruction immediate (`ldr w1, [x0, #4]`); no relocation names `g`.
# In a shared object that use would bind `g` to the library's own copy,
# which a program's definition preempts: mortar refuses the -fPIE object
# (`non-pic-in-shared-object`, the analysis's note names the function,
# the instruction and the relocation that formed the address). The -fPIC
# twin reaches `g` through the GOT: every linker links it, and the
# program's `g` is the one the library reads and writes (17, then 17 5;
# a library bound to its own `g` would print 10).
#@ spec: dyn.md "D-117"
#@ arch: aarch64

cc -O2 -fPIE gap2.c -o gap2-pie.o
cc -O2 -fPIC gap2.c -o gap2-pic.o
cc -O1 -fPIE main.c -o main.o
link gcc -shared gap2-pic.o -Wl,-soname,libgap.so -o libgap.so
link gcc -pie main.o -L. -lgap -o prog
run prog
  stdout: 17
  stdout: 17 5
link(mortar) gcc -shared gap2-pie.o -Wl,-soname,libbad.so -o libbad.so
  exit: fail
  diag: gap2-pie.o:(.text+*): relocation R_AARCH64_ADD_ABS_LO12_NC against symbol `g' which may bind externally can not be used when making a shared object; recompile with -fPIC
  diag: >>> the address .data+0x4 is accessed by the instruction at all+0xc

#--- gap2.c
static int h1 = 1, h2 = 2;
int g = 3;
static int h3 = 4;
int all(void) { return h1 + h2 + g + h3; }
void set(int v) { h1 = v; g = v; h3 = v; }
#--- main.c
#include <stdio.h>

int g = 10;
int all(void);
void set(int v);

int main(void) {
  printf("%d\n", all());
  set(5);
  printf("%d %d\n", all(), g);
  return 0;
}
