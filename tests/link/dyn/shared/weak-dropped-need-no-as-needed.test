# dyn.md D-11 item 1, D-27 (WP-137): the `--no-as-needed` twin of
# `weak-dropped-need`. `libv.so` stays needed, so the weak reference binds
# its versioned definition: `WEAK FUNC UND vfn@V1`, `DT_NEEDED` and a
# `Verneed` of `libv.so` (all three references alike); the library runs
# with `vfn` present (7 + 20). (No host defining `vfn` here: GNU ld does
# not export an unversioned program `vfn` for the library's `vfn@V1`, the
# verifier's D-12 W8 finding on the host.)
#@ spec: dyn.md "D-27"
#@ arch: aarch64 x86_64

cc -O1 -fPIC v.c -o v.o
cc -O1 -fPIC m2.c -o m2.o
cc -O1 -fPIC lib.c -o lib.o
cc -O1 -fPIE main.c -o main.o
shlib gcc v.o -Wl,--version-script=v.map -Wl,-soname,libv.so -o libv.so
shlib gcc m2.o -Wl,-soname,libm2.so -L. -Wl,--no-as-needed -lv -o libm2.so
link gcc -shared lib.o -L. -Wl,--no-as-needed -lv -lm2 -Wl,-soname,libwv.so -o libwv.so
check readelf -dW libwv.so
  has: (NEEDED) Shared library: [libv.so]
  has: (NEEDED) Shared library: [libm2.so]
check readelf -W --dyn-syms libwv.so
  has: FUNC WEAK DEFAULT UND vfn@V1
check readelf -VW libwv.so
  has: File: libv.so
host gcc -pie main.o -L. -lwv -lm2 -o prog
run prog
  stdout: 27

#--- v.map
V1 { global: vfn; local: *; };
#--- v.c
int vfn(void) { return 7; }
#--- m2.c
int m2fn(void) { return 20; }
#--- lib.c
int vfn(void) __attribute__((weak));
int m2fn(void);
int lf(void) { return (vfn ? vfn() : 0) + m2fn(); }
#--- main.c
#include <stdio.h>
int lf(void);
int main(void) { printf("%d\n", lf()); return 0; }
