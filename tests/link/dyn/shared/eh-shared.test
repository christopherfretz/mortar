# dyn.md D-125, D-102 (WP-123): a C++ exception thrown in the library is
# caught in the host, and one thrown by a host callback unwinds through
# the library's frame (PT_GNU_EH_FRAME is required: without it every
# throw out of a library aborts). The library needs the C library
# (`getenv`); a C++ library that does not: `cxx-weak-only-libc`.
#@ spec: dyn.md "D-125"
#@ requires: g++
#@ arch: aarch64 x86_64
#@ xfail(mortar,x86_64): M4: WP-127 (x86-64 shared objects; dyn.md D-100)

cxx -O1 -fPIC lib.cc -o lib.o
cxx -O1 -fPIE main.cc -o main.o
link g++ -shared lib.o -Wl,-soname,libeh.so -o libeh.so
check readelf -lW libeh.so
  has: GNU_EH_FRAME
host g++ -pie main.o -L. -leh -o prog
run prog
  stdout: caught boom
  stdout: caught 42 1

#--- lib.cc
#include <cstdlib>
#include <stdexcept>
int thrower(int x) {
  if (x > 0) throw std::runtime_error("boom");
  return x;
}
int call_back(int (*f)(int), int x) { return f(x) + (std::getenv("EH_SHARED_UNSET") ? 2 : 1); }
#--- main.cc
#include <cstdio>
#include <stdexcept>
int thrower(int);
int call_back(int (*)(int), int);
static int host_throw(int x) {
  if (x) throw 42;
  return 0;
}
int main() {
  try { thrower(1); } catch (const std::runtime_error &e) { std::printf("caught %s\n", e.what()); }
  try { call_back(host_throw, 1); } catch (int v) { std::printf("caught %d %d\n", v, call_back(host_throw, 0)); }
  return 0;
}
