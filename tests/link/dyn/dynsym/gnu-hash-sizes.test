#--- names.h
/* cb_0000 .. cb_4999 in blocks of ten, a hundred and a thousand */
#define D1(p) X(p##0) X(p##1) X(p##2) X(p##3) X(p##4) X(p##5) X(p##6) X(p##7) X(p##8) X(p##9)
#define D2(p) D1(p##0) D1(p##1) D1(p##2) D1(p##3) D1(p##4) D1(p##5) D1(p##6) D1(p##7) D1(p##8) D1(p##9)
#define D3(p) D2(p##0) D2(p##1) D2(p##2) D2(p##3) D2(p##4) D2(p##5) D2(p##6) D2(p##7) D2(p##8) D2(p##9)
#define ALL D3(cb_0) D3(cb_1) D3(cb_2) D3(cb_3) D3(cb_4)
#define TOTAL 5000
#--- lib.c
#define _GNU_SOURCE
#include <dlfcn.h>
#include <stdio.h>
#include "names.h"
#define X(name) extern int name(void) __attribute__((weak));
ALL
#undef X
#define X(name) name,
static int (*const table[])(void) = {ALL};

void lib_check(void) {
  int resolved = 0, called = 0, agrees = 0, absent = 0;
  char name[16];
  for (int i = 0; i < TOTAL; i++) {
    snprintf(name, sizeof name, "cb_%04d", i);
    void *found = dlsym(RTLD_DEFAULT, name);
    if (table[i]) {
      resolved++;
      called += table[i]() == i;
    } else if (!found) {
      absent++;
    }
    agrees += found == (void *)table[i];
  }
  printf("library: resolved %d of %d, called %d, dlsym agrees %d, absent rejected %d\n",
         resolved, TOTAL, called, agrees, absent);
}
#--- main.c
#include "dynwalk.h"
#include "names.h"
void lib_check(void);
static int number(const char *s) {
  int n = 0;
  for (; *s; s++) n = n * 10 + (*s - '0');
  return n;
}
/* cb_dddd returns dddd */
#define X(name) \
  int name(void) { return number(#name + 3); }
#if N == 1 || N == 2 || N == 3
X(cb_0000)
#endif
#if N == 2 || N == 3
X(cb_0001)
#endif
#if N == 3
X(cb_0002)
#endif
#if N == 10
D1(cb_000)
#endif
#if N == 100
D2(cb_00)
#endif
#if N == 1000
D3(cb_0)
#endif
#if N == 5000
ALL
#endif

int main(void) {
  struct dw w;
  if (!dw_open(&w)) return 1;
  int found = 0, hashed = 0;
  for (uint32_t i = w.symoffset; i < w.count; i++) {
    const char *name = w.str + w.sym[i].st_name;
    if (strncmp(name, "cb_", 3)) continue; /* GNU ld's x86-64 __cxa_finalize */
    hashed++;
    found += dw_lookup(&w, name) == i;
  }
  printf("n=%d: the table finds %d of %d hashed entries\n", N, found, hashed);
  lib_check();
  return 0;
}
