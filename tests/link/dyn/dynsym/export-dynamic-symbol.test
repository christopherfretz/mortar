# dyn.md D-21 (one more source of `exported`, §15 Q9) and cli.md:
# `--export-dynamic-symbol=GLOB` exports the executable's definitions
# whose names match GLOB, and only those, in a PIE and in `-no-pie`:
# `dlsym(RTLD_DEFAULT, ...)` finds them at the addresses the program
# uses, and `.dynsym` has them and not the definition no glob names
# (`other_fn`). The glob form (`exp_d*`) and the plain name both work.
# GNU ld, lld and mold agree (the same `.dynsym` set, the same run).
#@ spec: dyn.md "D-21"
#@ spec: cli.md "4.2 Status"
#@ arch: aarch64 x86_64

cc -O2 -fPIE main.c -o pie.o
cc -O2 -fno-pie main.c -o exec.o
link gcc -pie pie.o -Wl,--export-dynamic-symbol=exp_fn -Wl,--export-dynamic-symbol=exp_d* -o pie
run pie
  stdout: exp_fn found 1, same 1
  stdout: exp_data found 1, same 1
  stdout: other_fn found 0
check readelf --dyn-syms -W pie
  has: FUNC GLOBAL DEFAULT * exp_fn$
  has: OBJECT GLOBAL DEFAULT * exp_data$
  not: other_fn
  not: main$
link gcc -no-pie exec.o -Wl,--export-dynamic-symbol=exp_fn -Wl,--export-dynamic-symbol=exp_d* -o exec
run exec
  stdout: exp_fn found 1, same 1
  stdout: exp_data found 1, same 1
  stdout: other_fn found 0
check readelf --dyn-syms -W exec
  has: FUNC GLOBAL DEFAULT * exp_fn$
  has: OBJECT GLOBAL DEFAULT * exp_data$
  not: other_fn
  not: main$

#--- main.c
#include <dlfcn.h>
#include <stdio.h>

int exp_data = 7;
__attribute__((noinline)) int exp_fn(void) { return 42; }
__attribute__((noinline)) int other_fn(void) { return 1; }

int main(void) {
  void *f = dlsym(RTLD_DEFAULT, "exp_fn");
  void *d = dlsym(RTLD_DEFAULT, "exp_data");
  void *o = dlsym(RTLD_DEFAULT, "other_fn");
  printf("exp_fn found %d, same %d\n", f != 0, f == (void *)exp_fn);
  printf("exp_data found %d, same %d\n", d != 0, d == (void *)&exp_data);
  printf("other_fn found %d\n", o != 0 && other_fn() == 1);
  return 0;
}
