# dyn.md D-71: the dynamic loader's `--list` (what `ldd` runs: natively on
# AArch64, under qemu-x86_64 for x86-64) lists every needed object of a
# PIE and of a non-PIE against a fixture library, and finds the library
# through LD_LIBRARY_PATH (the linker's directory, spec/harness.md
# "Runs"). The interpreter is listed by its path.
#@ spec: dyn.md "D-71"
#@ arch: aarch64 x86_64
#@ fixture: greet

cc -O1 -fPIE main.c -o main.o
link gcc -pie main.o -L. -lgreet -o pie
run pie
  stdout: hello, ldd
  stdout: 41
check ldd pie
  has: libgreet.so => */libgreet.so (0x
  has: libc.so.6 => */libc.so.6 (0x
  has: ^ */ld-linux-*.so.* (0x
  not: not found
check readelf -dW pie
  has: (NEEDED) Shared library: [libgreet.so]
  then: (NEEDED) Shared library: [libc.so.6]
  count: 2 (NEEDED)

#--- main.c
#include <stdio.h>
#include "greet.h"

int main(void) {
  printf("%d\n", greet("ldd"));
  return 0;
}
