# dyn.md D-71: `eu-elflint --gnu-ld` passes GNU ld's dynamic outputs
# and must pass mortar's with no allowance. mortar's RELRO padding is
# named `.pad.relro` (layout L-156) because elflint takes a name that
# starts with `.rel` for a relocation section; lld's and mold's
# `.relro_padding` draws that complaint, and they draw others
# (headers-first `Vernaux`, `.rodata` entry sizes; D-71): elflint is not
# their judge, and their links are checked here for running only.
#
#@ spec: dyn.md "D-71"
#@ arch: aarch64 x86_64
#@ requires: eu-elflint
#@ fixture: greet

cc -O1 -fPIE main.c -o pie.o
cc -O1 -fno-pie main.c -o exec.o
link gcc -pie pie.o -L. -lgreet -o pie
run pie
  stdout: hello, elflint
link gcc -no-pie exec.o -L. -lgreet -o exec
run exec
  stdout: hello, elflint
check(bfd,mortar) elflint pie
check(bfd,mortar) elflint exec

#--- main.c
#include "greet.h"

int main(void) {
  greet("elflint");
  return 0;
}
