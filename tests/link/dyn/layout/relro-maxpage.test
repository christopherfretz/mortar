# dyn.md D-61 (layout L-64): the PT_GNU_RELRO run ends on a max-page
# boundary: 64 KiB on AArch64 (a kernel may use 64 KiB pages, and
# mprotect works in its pages), 4 KiB on x86-64; PT_DYNAMIC lies inside
# it (D-33). The program reads its own program headers with
# dl_iterate_phdr and prints whether (load bias + p_vaddr + p_memsz) of
# PT_GNU_RELRO is a multiple of the max-page size, and whether PT_DYNAMIC
# is inside the run. PIE and -no-pie.
#
# Where the references differ (dyn.md 13.1, "RELRO end on AArch64"):
# GNU ld and mold end the run on a 64 KiB boundary on AArch64; lld ends it
# on a 4 KiB one (mid-page on a 64 KiB-page kernel; not run: none
# available), so lld's AArch64 run prints `relro-end-maxpage 0`. All
# three end it on a 4 KiB boundary on x86-64.
#@ spec: dyn.md "D-61"
#@ arch: aarch64 x86_64

cc -O1 -fPIE relro.c -o pie.o
cc -O1 -fno-pie relro.c -o exec.o
link gcc -pie pie.o -o pie
link gcc -no-pie exec.o -o exec
check readelf -lW pie
  has: ^ GNU_RELRO
check readelf -lW exec
  has: ^ GNU_RELRO
run(bfd,mold,mortar) pie
  stdout: relro-end-maxpage 1
  stdout: dynamic-in-relro 1
run(lld,x86_64) pie
  stdout: relro-end-maxpage 1
  stdout: dynamic-in-relro 1
run(lld,aarch64) pie
  stdout: relro-end-maxpage 0
  stdout: dynamic-in-relro 1
run(bfd,mold,mortar) exec
  stdout: relro-end-maxpage 1
  stdout: dynamic-in-relro 1
run(lld,x86_64) exec
  stdout: relro-end-maxpage 1
  stdout: dynamic-in-relro 1
run(lld,aarch64) exec
  stdout: relro-end-maxpage 0
  stdout: dynamic-in-relro 1

#--- relro.c
#define _GNU_SOURCE
#include <link.h>
#include <stdio.h>

#if defined(__aarch64__)
#define MAXPAGE 0x10000UL
#else
#define MAXPAGE 0x1000UL
#endif

static int seen;

static int each(struct dl_phdr_info *info, size_t size, void *data) {
  (void)size;
  (void)data;
  if (seen++)
    return 1; /* the program itself is the first object */
  unsigned long start = 0, end = 0, dyn = 0, dynend = 0;
  for (int i = 0; i < info->dlpi_phnum; i++) {
    const ElfW(Phdr) *p = &info->dlpi_phdr[i];
    unsigned long at = info->dlpi_addr + p->p_vaddr;
    if (p->p_type == PT_GNU_RELRO) {
      start = at;
      end = at + p->p_memsz;
    } else if (p->p_type == PT_DYNAMIC) {
      dyn = at;
      dynend = at + p->p_memsz;
    }
  }
  printf("relro-end-maxpage %d\n", end != 0 && end % MAXPAGE == 0);
  printf("dynamic-in-relro %d\n", dyn >= start && dynend <= end && dyn != 0);
  return 1;
}

int main(void) {
  dl_iterate_phdr(each, NULL);
  return 0;
}
