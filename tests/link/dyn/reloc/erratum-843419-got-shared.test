# Erratum 843419 at a GOT page against a symbol only a shared library
# defines (WP-100 defect RB-2, found by `cargo xtask realbuild` in
# abseil 20240722.0's absl_log_structured_test, gcc row: GCC's
# `adrp x0, :got:__libc_single_threaded; ldr x0, [x0, :got_lo12:...];
# ldrb w0, [x0]` at page offset 0xFFC). spec/a64.md §11.1 makes it a
# site and §11.2 gives it a fix (`W1` 311: `V` is `G(GDAT(S))`). GCC on
# Debian passes --fix-cortex-a53-843419 to every link; the line spells it
# as well, for a driver that does not. GNU ld writes the ADR to the
# slot's page at both sites, and since WP-103 so does mortar. Until
# then mortar left the GOT site's ADRP: the erratum scan's stand-in for
# the symbol's unknown address made the ADRP an ADD in the round's words,
# so the predicate never saw it. The verifier knows the option from the
# line (WP-103; before, it inferred it from the fixes it found). lld and
# mold leave both ADRPs (`W2` writes `Xn`, a shape the verifier does not
# judge on a reference output, plumb.md A4).
#@ spec: a64.md "11.1 The predicate"
#@ spec: a64.md "11.2 The fix"
#@ arch: aarch64

as f.s -o f.o
cc -O1 -fPIE main.c -o main.o
link gcc -pie -Wl,--fix-cortex-a53-843419 main.o f.o -o prog
run prog
  stdout: ok
check(mortar) objdump -d --disassemble=f prog
  has: ffc: * adr x0, 
  has: ff8: * adr x1, 
check(bfd) objdump -d --disassemble=f prog
  has: ffc: * adr x0, 
  has: ff8: * adr x1, 

#--- f.s
	.text
	.balign	4096
	.globl	f
	.type	f, %function
f:
	.rept	1023
	nop
	.endr
	// A site whose ADRP is a GOT page against a symbol of libc.so.
	adrp	x0, :got:environ
	ldr	x0, [x0, :got_lo12:environ]
	ldrb	w0, [x0]
	.rept	1020
	nop
	.endr
	// A site whose ADRP is a direct page of the executable's own data.
	adrp	x1, v
	ldr	x1, [x1, :lo12:v]
	ldrb	w1, [x1]
	ret
	.size	f, .-f
	.data
	.balign	8
v:	.quad	v
#--- main.c
#include <stdio.h>
int f(void);
int main(void) { f(); puts("ok"); return 0; }
