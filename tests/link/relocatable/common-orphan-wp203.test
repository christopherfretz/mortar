# WP-203: lld's `-r` of a component with a common writes it as an input
# section named `COMMON` (NOBITS, WA; plumb.md A120); GNU ld, lld and
# mortar place it in `.bss` at the final link (layout.md L-44a, proposed
# in spec/landed/layout/WP-203.md). Before WP-203 mortar made it an orphan
# output section `COMMON` (P-P1 item 1). The variants are
# layout/common-section.test.
#@ spec: plumb.md "14.8"
#@ spec: layout.md "L-44a"

cc -O1 -fcommon c1.c -o c1.o
cc -O1 main.c -o main.o
partial lld c1.o -o comp.lld.o
check readelf -SW comp.lld.o
  has: COMMON

link gcc -static main.o comp.lld.o -o via
run via
  stdout: 5
# mold orphans it too (record WP-186): not checked for mold.
check(bfd,lld,mortar) readelf -SW via
  not: COMMON
  has: .bss NOBITS
check(bfd,lld,mortar) nm via
  has: B g_common$
  has: B g_other$

#--- c1.c
int g_common;
int g_other;
void set(void) { g_common = 2; g_other = 3; }
#--- main.c
#include <stdio.h>
extern int g_common, g_other;
void set(void);
int main(void) { set(); printf("%d\n", g_common + g_other); return 0; }
