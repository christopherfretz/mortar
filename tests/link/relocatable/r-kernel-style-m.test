# RL-7 (WP-187): the kernel-style line with `-m` (record
# spec/landed/layout/WP-154.md §A.3), as `partial mortar` runs it
# (`mortar -m %{emulation} -r`): judged by stage R, linked twice (LT-R4),
# and final-linked by every linker of the matrix (LT-R1, LT-R3); GNU
# ld's and lld's -r of the same line are final-linked beside it.
# Kbuild's objects: `-fno-common`, a static counter, initialized and zero
# data, merged strings, a call between the two files.
#@ spec: harness.md "Relocatable outputs"
#@ spec: resolve.md "11"
#@ arch: aarch64
#@ requires: eu-elflint

cc -O2 -fno-common a.c -o a.o
cc -O2 -fno-common b.c -o b.o
cc -O2 main.c -o main.o
partial mortar -o built-in.o a.o b.o
partial bfd -m %{emulation} -o built-in.bfd.o a.o b.o
partial lld -m %{emulation} -o built-in.lld.o a.o b.o
check readelf -hW built-in.o
  has: Type: *REL (Relocatable file)
check nm built-in.o
  has: T a_next$
  has: T b_report$
  has: b a_count$
check elflint built-in.o

link gcc -static main.o a.o b.o -o direct
run direct
  stdout: a=3 b=7 s=kernel
link gcc -static main.o built-in.o -o via
run via
  stdout: a=3 b=7 s=kernel
link gcc main.o a.o b.o -o direct-pie
run direct-pie
  stdout: a=3 b=7 s=kernel
link gcc main.o built-in.o -o via-pie
run via-pie
  stdout: a=3 b=7 s=kernel
link gcc -static main.o built-in.bfd.o -o via-bfd
run via-bfd
  stdout: a=3 b=7 s=kernel
link gcc -static main.o built-in.lld.o -o via-lld
run via-lld
  stdout: a=3 b=7 s=kernel

#--- a.c
static int a_count;
int a_seed = 2;
int a_next(void) { return a_seed + ++a_count; }
const char *a_name(void) { return "kernel"; }
#--- b.c
#include <stdio.h>
int a_next(void);
const char *a_name(void);
int b_table[4] = {4, 5, 6, 7};
void b_report(void) {
  int a = a_next();
  printf("a=%d b=%d s=%s\n", a, b_table[3], a_name());
}
#--- main.c
void b_report(void);
int main(void) { b_report(); return 0; }
