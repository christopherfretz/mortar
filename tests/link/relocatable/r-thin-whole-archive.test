# RL-7 (WP-187): `--whole-archive` of a thin archive at -r (record
# spec/landed/layout/WP-154.md §A.3, all three references): every member,
# read from its own file, is linked in. Judged by stage R, linked twice
# (LT-R4), final-linked by every linker of the matrix.
#@ spec: resolve.md "11"
#@ spec: harness.md "Relocatable outputs"
#@ arch: aarch64
#@ requires: eu-elflint

cc -O2 m1.c -o m1.o
cc -O2 m2.c -o m2.o
cc -O2 main.c -o main.o
ar rcsT libthin.a m1.o m2.o
partial mortar --whole-archive libthin.a --no-whole-archive -o all.o
partial bfd -m %{emulation} --whole-archive libthin.a --no-whole-archive -o all.bfd.o
check nm all.o
  has: T m1_value$
  has: T m2_value$
check nm all.bfd.o
  has: T m1_value$
  has: T m2_value$
check elflint all.o

link gcc -static main.o -Wl,--whole-archive libthin.a -Wl,--no-whole-archive -o direct
run direct
  stdout: 33
link gcc -static main.o all.o -o via
run via
  stdout: 33

#--- m1.c
int m1_value(void) { return 11; }
#--- m2.c
int m2_value(void) { return 22; }
#--- main.c
#include <stdio.h>
int m1_value(void);
int m2_value(void);
int main(void) { printf("%d\n", m1_value() + m2_value()); return 0; }
