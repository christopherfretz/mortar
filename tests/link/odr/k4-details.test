base type=1X offset=0
member name=d type=i offset=32
type name=1V size=16 align=8 flags=4 file=h.h line=4
member name=x type=i offset=64
vptr offset=0
slot name=_ZN1V1fEv index=0
slot name=_ZN1V1gEv index=1
type name=1E size=4 align=4 flags=1 file=h.h line=5
underlying type=j
enumerator name=A value=0
enumerator name=B value=1
#--- b.cc
struct M { int a; int b; };
struct Y { int y; };
struct D : Y { int d; };
struct V { virtual int f() { return 1; } int x; };
enum E { A, B = 5 };
int fb(M* m, D* d, V* v) { return m->b + d->d + v->x + (B == 5); }
