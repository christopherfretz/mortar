# Kind 4, layout details (spec/odr.md O-19, §9.1; WP-145), under
# --odr=strict: four classes that differ between two translation units,
# with the details kiln writes at -fmason-metadata=detail. Each
# odr-type-mismatch names the first differing item: a member of another
# type, another base, a virtual function added, an enumerator changed.
# The classes are reached through pointers only: no vtable or type_info is
# emitted, so only the records see the differences. k4-details-default
# is the same link without kind 4.
#@ spec: odr.md O-19, §9.1
#@ requires: g++
#@ diag: odr-type-mismatch a.o b.o
#@ diag: odr-type-mismatch a.o b.o
#@ diag: odr-type-mismatch a.o b.o
#@ diag: odr-type-mismatch a.o b.o

cxx -O0 a.cc -o a0.o
meta a.meta a0.o -o a.o
cxx -O0 b.cc -o b0.o
meta b.meta b0.o -o b.o
cxx -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o a.o b.o -o prog
link(mortar) g++ -static -no-pie main.o a.o b.o -Wl,--odr=strict -o prog
  exit: fail
  diag: ^>>> member 'b' (l) at offset 8 in a.o; 'b' (i) at offset 4 in b.o$
  diag: ^>>> base 1X at offset 0 in a.o; base 1Y at offset 0 in b.o$
  diag: ^>>> vtable slot 1: _ZN1V1gEv in a.o only$
  diag: ^>>> enumerator 'B' = 1 in a.o; 'B' = 5 in b.o$
  no-diag: size 16, alignment 8
  no-diag: with the same size

#--- a.cc
struct M { int a; long b; };
struct X { int x; };
struct D : X { int d; };
struct V { virtual int f() { return 1; } virtual int g() { return 2; } int x; };
enum E { A, B };
int fa(M* m, D* d, V* v) { return int(m->b) + d->d + v->x + (B == 1); }
#--- a.meta
