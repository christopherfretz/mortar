definition anchor=_Z4addrv hash=5613a39f98f0bff657de825293403fc4 class=1 flags=1 file=h.h line=1
#--- b17.cc
struct A { static constexpr int n = 3; };
__attribute__((noinline)) inline const int* addr() { return &A::n; }
int fb() { return *addr(); }
