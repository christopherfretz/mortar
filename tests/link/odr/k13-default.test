# K13 in the default mode (spec/odr.md O-47: W3 is strict only): no
# one-definition-rule diagnostic.
#@ spec: odr.md §9.2
#@ requires: g++

cxx -O0 a.cc -o a.o
cxx -O0 b.cc -o b.o
cxx -O0 main.cc -o main.o
link g++ -static -no-pie main.o a.o b.o -o prog
run prog
  stdout: 2 2

#--- t.h
template <typename T> int pick(T) { return 1; }
#--- a.cc
#include "t.h"
int fa() { return pick(0); }
#--- b.cc
#include "t.h"
template <> int pick<int>(int) { return 2; }
int fb() { return pick(0); }
#--- main.cc
#include <cstdio>
int fa();
int fb();
int main() { std::printf("%d %d\n", fa(), fb()); }
