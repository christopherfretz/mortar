# Model case mixed-std-implicit-dtor (spec/odr.md §12.7, experiments 2 and 3), under
# --odr=strict.
# The implicit destructor of X is constexpr in C++20 only; the revised O-10
# hashes explicitly written specifiers only, so both units write one hash
# (N25).
#@ spec: odr.md §3 N25, §12.7, "O-10"
#@ requires: g++

cxx -O0 -std=c++17 a.cc -o a0.o
meta a.meta a0.o -o a.o
cxx -O0 -std=c++20 b.cc -o b0.o
meta b.meta b0.o -o b.o
cxx -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o a.o b.o -o prog
link(mortar) g++ -static -no-pie main.o a.o b.o -Wl,--odr=strict -o prog
run prog
  stdout: 0 0

#--- a.cc
#include <string>
struct X { std::string s; };
__attribute__((noinline)) inline int use() { X x; return (int)x.s.size(); }
int fa() { return use(); }
