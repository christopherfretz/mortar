# The legal corpus's shapes that records could flag (spec/odr.md §3), with
# the records kiln would write, under --odr=strict: nothing is reported.
#   n1a, n1b    N1: one inline function at -O0 and -O2, one hash; a
#               duplicate identical row in one unit; a kind 3 row whose
#               hash is zero ("not hashed", O-17) beside a hashed one
#   n3a, n3b    N3: g++ and clang++ objects whose schemes differ: their
#               kind 2 and 3 rows are never compared (O-11)
#   n9a, n9b    N9: an explicit instantiation and an implicit copy
#               (EXPLICIT_INST and IMPLICIT_INST are compatible, O-15)
#   n12a, n12b  N12: a renamed copy whose row still names the old symbol
#               (unanchored, O-4)
#   n13a, n13b  N13, N31: internal-linkage symbols are never anchors (O-2)
#   libn14.a    N14: a member that is not extracted (O-20: live files only)
#   n15a, n15b  N15: an array of unknown bound and its definition (O-35)
#   n21a, n21b  N21, N27: kind 2 and 3 rows of C units are set aside
#               (O-14, O-33)
#   n5a, n5b    O-35: two definitions are never compared with each other
#@ spec: odr.md §3, "O-2", "O-4", "O-11", "O-14", "O-15", "O-17", "O-20", "O-33", "O-35"
#@ requires: g++ clang

cxx -O0 n1a.cc -o n1a0.o
meta n1a.meta n1a0.o -o n1a.o
cxx -O2 n1b.cc -o n1b0.o
meta n1b.meta n1b0.o -o n1b.o
cxx -O0 n3a.cc -o n3a0.o
meta n3a.meta n3a0.o -o n3a.o
cxx(clang) -O0 n3b.cc -o n3b0.o
meta n3b.meta n3b0.o -o n3b.o
cxx -O0 n9a.cc -o n9a0.o
meta n9a.meta n9a0.o -o n9a.o
cxx -O0 n9b.cc -o n9b0.o
meta n9b.meta n9b0.o -o n9b.o
cxx -O0 n12a.cc -o n12a0.o
meta n12a.meta n12a0.o -o n12a.o
cxx -O0 n12b.cc -o n12b0.o
meta n12b.meta n12b0.o -o n12b.o
cxx -O0 n13a.cc -o n13a0.o
meta n13a.meta n13a0.o -o n13a.o
cxx -O0 n13b.cc -o n13b0.o
meta n13b.meta n13b0.o -o n13b.o
cxx -O0 n14.cc -o n140.o
meta n14.meta n140.o -o n14.o
cxx -O0 n15a.cc -o n15a0.o
meta n15a.meta n15a0.o -o n15a.o
cxx -O0 n15b.cc -o n15b0.o
meta n15b.meta n15b0.o -o n15b.o
cc -O0 n21a.c -o n21a0.o
meta n21a.meta n21a0.o -o n21a.o
cc -O0 n21b.c -o n21b0.o
meta n21b.meta n21b0.o -o n21b.o
cxx -O0 n5a.cc -o n5a0.o
meta n5a.meta n5a0.o -o n5a.o
cxx -O0 n5b.cc -o n5b0.o
meta n5b.meta n5b0.o -o n5b.o
ar rcs libn14.a n14.o
cxx -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o n1a.o n1b.o n3a.o n3b.o n9a.o n9b.o n12a.o n12b.o n13a.o n13b.o n15a.o n15b.o n21a.o n21b.o n5a.o n5b.o libn14.a -o prog
link(mortar) g++ -static -no-pie main.o n1a.o n1b.o n3a.o n3b.o n9a.o n9b.o n12a.o n12b.o n13a.o n13b.o n15a.o n15b.o n21a.o n21b.o n5a.o n5b.o libn14.a -Wl,--odr=strict -o prog
run prog
  stdout: 1 1 3 3 9 9 12 12 13 13 15 21 21 5

