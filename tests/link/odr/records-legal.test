#--- main.cc
#include <cstdio>
template <typename T> int tw(T);
extern template int tw<int>(int);
int f1a(); int f1b(); int f3a(); int f3b(); int f9(); int f12a(); int f12b();
int f13a(); int f13b(); int f15();
extern "C" int f21a(); extern "C" int f21b();
extern int n5v;
int main() {
  std::printf("%d %d %d %d %d %d %d %d %d %d %d %d %d %d\n", f1a(), f1b(), f3a(), f3b(), tw(0),
              f9(), f12a(), f12b(), f13a(), f13b(), f15(), f21a(), f21b(), n5v);
}
