# Model case K16c-catalogue-shape (spec/odr.md §12.7, experiments 2 and 3), under
# --odr=strict.
# The catalogue's K16c: only b (-fno-rtti) emits the vtables; a emits _ZTI1D
# for its dynamic_cast. O-25 needs two vtable copies, so this is X3 and
# nothing is reported (Q16 asks about the typeinfo extension).
#@ spec: odr.md §12.7, "O-25"
#@ requires: g++

cxx -O0 a.cc -o a0.o
meta a.meta a0.o -o a.o
cxx -O0 -fno-rtti b.cc -o b0.o
meta b.meta b0.o -o b.o
cxx -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o a.o b.o -o prog
link(mortar) g++ -static -no-pie main.o a.o b.o -Wl,--odr=strict -o prog
run prog
  stdout: 1

#--- a.cc
struct B { virtual int f() { return 1; } virtual ~B() {} };
struct D : B {};
B* makeD();
int fa() { B* b = makeD(); return dynamic_cast<D*>(b) ? 1 : 0; }
#--- a.meta
# the records kiln would write (spec/odr.md §12.7)
summary name=abi.rtti value=on
summary name=lang value=c++
summary name=odr.scheme value=model-1
summary name=producer value="hand (WP-070 model)"
summary name=std value=c++17
type name=1B hash=e1a7c6e9c389c3229ecf0e70570c0d08 layout=0x84b990f490c4db00 size=8 align=8 flags=4 file=h.h line=1
type name=1D hash=7b5c92f011d09aa3d0c8b236af9b8e0c layout=0x30f8510b22389f50 size=8 align=8 flags=4 file=h.h line=1
#--- b.cc
struct B { virtual int f() { return 1; } virtual ~B() {} };
struct D : B {};
B* makeD();
B* makeD() { return new D; }
int fb() { return makeD()->f(); }
#--- b.meta
# the records kiln would write (spec/odr.md §12.7)
summary name=abi.rtti value=off
summary name=lang value=c++
summary name=odr.scheme value=model-1
summary name=producer value="hand (WP-070 model)"
summary name=std value=c++17
type name=1B hash=e1a7c6e9c389c3229ecf0e70570c0d08 layout=0x84b990f490c4db00 size=8 align=8 flags=4 file=h.h line=1
type name=1D hash=7b5c92f011d09aa3d0c8b236af9b8e0c layout=0x30f8510b22389f50 size=8 align=8 flags=4 file=h.h line=1
#--- main.cc
#include <cstdio>
int fb();
int main() { std::printf("%d\n", fb()); }
