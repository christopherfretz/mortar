# Model case K7-revised (spec/odr.md §12.7, experiments 2 and 3), under
# --odr=strict.
# The revised O-10 hashes an enumerator as type, name and value, and the
# revised O-17 writes a row for the type of every expression: isB(int)
# differs (odr-violation) and so does E's layout (odr-type-mismatch);
# both are errors under strict.
#@ spec: odr.md §12.7, "O-10", "O-17", "O-41"
#@ requires: g++
#@ diag: odr-type-mismatch a.o b.o
#@ diag: odr-violation a.o b.o

cxx -O0 a.cc -o a0.o
meta a.meta a0.o -o a.o
cxx -O0 b.cc -o b0.o
meta b.meta b0.o -o b.o
cxx -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o a.o b.o -o prog
link(mortar) g++ -static -no-pie main.o a.o b.o -Wl,--odr=strict -o prog
  exit: fail
  diag: violates the one-definition rule
run(bfd,lld,mold) prog
  stdout: 1 0

#--- a.cc
enum E { A, B };
__attribute__((noinline)) inline int isB(int e) { return e == B; }
int fa() { return isB(B); }
#--- a.meta
