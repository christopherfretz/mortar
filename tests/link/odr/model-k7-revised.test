type name=1E hash=88aaa53975aba44a9d9d6c6d0d7440b9 layout=0x878620ecf5f4df8b size=4 align=4 flags=1 file=h.h line=1
#--- b.cc
enum E { A, X, B };
__attribute__((noinline)) inline int isB(int e) { return e == B; }
int fb() { return isB(B); }
