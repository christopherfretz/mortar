# kiln's kind 2 rows beside rows it cannot be compared with (spec/odr.md
# O-11, O-14, X9, X13; WP-174), under --odr=strict: one inline function
# shared_fn with three bodies (N=1, 2, 3), in
# - k.o: kiln 4b017b227, scheme kiln-odr-1.d2, its row hashing the body;
# - h.o: a GCC object with a hand-written unit of kiln K-3a's scheme
#   kiln-odr-1.d0 (the declared type only, PARTIAL) for the same key:
#   two different schemes are never compared (O-11, X13), only counted
#   (`schemes 2, pairs not compared 1`);
# - g.o: a GCC object without a container: no row on that side, nothing
#   to compare (X9); the W checks see no difference in the bytes they
#   read (W4 does not compare functions' code).
# Nothing is reported, the program runs k.o's copy (the first). The
# units have no kind 3 rows: `layout schemes 0`.
#@ spec: odr.md O-11, O-14
#@ arch: aarch64 x86_64
#@ requires: kiln g++

cxx(kiln) -O0 -DN=1 -fmason-metadata k.cc -o k.o
cxx -O0 -DN=2 h.cc -o h0.o
meta h.meta h0.o -o h.o
cxx -O0 -DN=3 g.cc -o g.o
cxx(kiln) -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o k.o h.o g.o -o prog
link(mortar) g++ -static -no-pie main.o k.o h.o g.o -Wl,--odr=strict -Wl,--odr-stats -o prog
  diag: ^mortar: odr-stats: mode strict; units 2, rows * kind 2 2,* schemes 2, pairs not compared 1, layout schemes 0,* record findings 0;* findings W1 0, W2 0, W3 0, W4 0;
run prog
  stdout: 1 1 1

#--- s.h
__attribute__((noinline)) inline int shared_fn() { return N; }
#--- k.cc
#include "s.h"
int fk() { return shared_fn(); }
#--- h.cc
#include "s.h"
int fh() { return shared_fn(); }
#--- g.cc
#include "s.h"
int fg() { return shared_fn(); }
#--- main.cc
#include <cstdio>
int fk();
int fh();
int fg();
int main() { std::printf("%d %d %d\n", fk(), fh(), fg()); }
#--- h.meta
# a unit of kiln K-3a's scheme (every row PARTIAL, the declared type only)
summary name=lang value=c++
summary name=odr.scheme value=kiln-odr-1.d0
summary name=producer value="kiln (K-3a)"
summary name=source value=h.cc
summary name=std value=c++17
definition anchor=_Z9shared_fnv hash=d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0 class=1 flags=0x21 file=s.h line=1
