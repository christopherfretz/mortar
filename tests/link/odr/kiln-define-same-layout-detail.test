# kiln-define-same-layout at -fmason-metadata=detail (spec/odr.md O-10,
# O-17, O-19): the same two units with kind 4 descriptions written. Kind
# 3 agrees, so no description is read (`layout details read 0`); since
# kiln K-3e (scheme kiln-odr-1.d4) S::get's rows differ by their own
# default argument (`k = TRACE`), a true finding under --odr=strict, as
# at the default level. Split from kiln-define-same-layout by WP-199 (a
# `#@ diag:` holds for every link of a test).
#@ spec: odr.md O-10, O-17, O-19
#@ arch: aarch64 x86_64
#@ requires: kiln g++
#@ diag: odr-violation a.o b.o

cxx(kiln) -O0 -DTRACE=1 -fmason-metadata=detail a.cc -o a.o
cxx(kiln) -O0 -DTRACE=2 -DWITH_NAME -fmason-metadata=detail b.cc -o b.o
cxx(kiln) -O0 main.cc -o main.o
link(mortar) g++ main.o a.o b.o -Wl,--odr=strict -Wl,--odr-stats -o strict
  exit: fail
  diag: ^mortar: error: _ZNK1S3getEi violates the one-definition rule$
  diag: ^mortar: odr-stats: mode strict; units 2, rows * kind 3 *, layout details read 0, record findings 1;

#--- s.h
struct S {
  int a = TRACE;
  long b;
  static const int level = TRACE;
  int get(int k = TRACE) const { return a * 0 + k + 10 + level * 0 + 1; }
#ifdef WITH_NAME
  const char* name() const { return "S"; }
#endif
};
struct Base { virtual ~Base() {} virtual int v() const { return TRACE; } int x; };
struct Derived : Base { int v() const override { return TRACE + 1; } S s; };
#--- a.cc
#include "s.h"
int from_a(S* s, Base* b) { return s->get(2) + (b ? b->x : 0); }
#--- b.cc
#include "s.h"
int from_b(S* s, Base* b) {
#ifdef WITH_NAME
  (void)s->name();
#endif
  return s->get(2) + (b ? b->x : 0);
}
#--- main.cc
#include <stdio.h>
struct S;
struct Base;
int from_a(S*, Base*);
int from_b(S*, Base*);
int main() {
  alignas(16) static char buf[64] = {};
  printf("%d %d\n", from_a((S*)buf, nullptr), from_b((S*)buf, nullptr));
  return 0;
}
