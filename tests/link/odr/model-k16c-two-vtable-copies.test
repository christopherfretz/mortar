type name=1D hash=7b5c92f011d09aa3d0c8b236af9b8e0c layout=0x30f8510b22389f50 size=8 align=8 flags=4 file=h.h line=1
#--- b.cc
struct B { virtual int f() { return 1; } virtual ~B() {} };
struct D : B {};
B* makeD();
B* makeD() { return new D; }
int fb() { return makeD()->f(); }
#--- b.meta
# the records kiln would write (spec/odr.md §12.7)
