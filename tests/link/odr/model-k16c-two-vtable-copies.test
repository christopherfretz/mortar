# Model case K16c-two-vtable-copies (spec/odr.md §12.7, experiments 2 and 3), under
# --odr=strict.
# No key function: _ZTV1B and _ZTV1D are COMDAT copies in both units, whose
# abi.rtti differ: odr-vtable-rtti-mismatch for B and for D (O-25). W4
# (strict) also sees the copies' contents differ: the RTTI slot.
#@ spec: odr.md §12.7, "O-25"
#@ requires: g++
#@ diag: odr-contents-mismatch a.o b.o
#@ diag: odr-contents-mismatch a.o b.o
#@ diag: odr-vtable-rtti-mismatch a.o b.o
#@ diag: odr-vtable-rtti-mismatch a.o b.o

cxx -O0 a.cc -o a0.o
meta a.meta a0.o -o a.o
cxx -O0 -fno-rtti b.cc -o b0.o
meta b.meta b0.o -o b.o
cxx -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o a.o b.o -o prog
link(mortar) g++ -static -no-pie main.o a.o b.o -Wl,--odr=strict -o prog
run prog
  stdout: 1 1

#--- a.cc
struct B { virtual int f() { return 1; } virtual ~B() {} };
struct D : B {};
B* makeD();
int fa() { B* b = makeD(); return dynamic_cast<D*>(b) ? 1 : 0; }
int fa2() { D d; return d.f(); }
