# Model case K7-old-rules (spec/odr.md §12.7, experiments 2 and 3), under
# --odr=strict.
# The old O-10 hashed the enumerator by name and the old O-17 did not reach
# E: both units write equal rows, and nothing is reported (the review's
# B2, the reason for the revision).
#@ spec: odr.md §12.7
#@ requires: g++

cxx -O0 a.cc -o a0.o
meta a.meta a0.o -o a.o
cxx -O0 b.cc -o b0.o
meta b.meta b0.o -o b.o
cxx -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o a.o b.o -o prog
link(mortar) g++ -static -no-pie main.o a.o b.o -Wl,--odr=strict -o prog
run prog
  stdout: 1 0

#--- a.cc
enum E { A, B };
__attribute__((noinline)) inline int isB(int e) { return e == B; }
int fa() { return isB(B); }
#--- a.meta
