# Kind 4 shapes that only kiln writes (spec/odr.md O-19, §9.1; WP-134),
# under --odr=strict at -fmason-metadata=detail: a virtual base (two base
# items: the direct-base list, then all virtual bases), a member of an
# unnamed class type (an item with an empty type, then the nested
# class's items), a pure virtual slot (`__cxa_pure_virtual`), a negative
# enumerator, and `enum H : unsigned` against `enum H` (one underlying
# type, hashed differently on purpose). Each odr-type-mismatch's note
# names the first differing item as mortar prints it: the member of the
# unnamed union "of the unnamed member at offset 0" (kiln 4b017b227 writes
# the unnamed member's `width`, O-19: here 2, the union's two members, so
# `k` after them is U's own), the negative enumerator in signed decimal
# (WP-151), and for H the underlying type's bits (from kiln 19428a411's
# scheme kiln-odr-1.d5 on, frozen as kiln-odr-1 by de347b847, kiln writes
# O-18's scoped/fixed byte in the item's value, WP-204; with .d4 the items
# were equal and the note said kind 4 does not
# describe the difference). kiln's slot index is the component's index in the vtable group
# with the RTTI slot left out (offset-to-top is 0): the first virtual
# function is slot 1, which the help note under the slot says.
#@ spec: odr.md O-19, §9.1
#@ arch: aarch64 x86_64
#@ requires: kiln g++
#@ diag: odr-type-mismatch a.o b.o
#@ diag: odr-type-mismatch a.o b.o
#@ diag: odr-type-mismatch a.o b.o
#@ diag: odr-type-mismatch a.o b.o
#@ diag: odr-type-mismatch a.o b.o

cxx(kiln) -O0 -fmason-metadata=detail a.cc -o a.o
cxx(kiln) -O0 -fmason-metadata=detail b.cc -o b.o
cxx(kiln) -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o a.o b.o -o prog
link(mortar) g++ -static -no-pie main.o a.o b.o -Wl,--odr=strict -o prog
  exit: fail
  diag: ^>>> base 3VB1 at offset 12 (virtual) in a.o; base 3VB2 at offset 16 (virtual) in b.o$
  diag: ^>>> member 'f' (f) at offset 0 of the unnamed member at offset 0 in a.o; member 'l' (l) at offset 0 of the unnamed member at offset 0 in b.o$
  diag: ^>>> vtable slot 1: __cxa_pure_virtual in a.o; vtable slot 1: _ZN1P1fEv in b.o$
  diag: ^>>> vtable slots are numbered over the whole vtable group from 0, its offset-to-top, vcall and vbase entries counted and its RTTI entries not (spec/odr.md O-18, O-19)$
  diag: ^>>> enumerator 'N0' = -2 in a.o; 'N0' = -3 in b.o$
  diag: ^>>> underlying type j (unscoped, fixed) in a.o; j (unscoped, not fixed) in b.o$

#--- a.cc
struct VB1 { int v; };
struct VB2 { long v; };
struct W : virtual VB1 { int w; };
struct U { union { int i; float f; }; int k; };
struct P { virtual int f() = 0; virtual int g(); };
enum N { N0 = -2, N1 };
enum H : unsigned { H0, H1 };
int fa(W* w, U* u, P* p, N* n, H* h) { return w->w + u->k + p->g() + int(*n) + int(*h); }
#--- b.cc
struct VB1 { int v; };
struct VB2 { long v; };
struct W : virtual VB2 { int w; };
struct U { union { int i; long l; }; int k; };
struct P { virtual int f(); virtual int g(); };
enum N { N0 = -3, N1 };
enum H { H0, H1 };
int fb(W* w, U* u, P* p, N* n, H* h) { return w->w + u->k + p->g() + int(*n) + int(*h); }
#--- main.cc
int main() { return 0; }
