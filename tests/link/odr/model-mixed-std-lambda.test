# Model case mixed-std-lambda (spec/odr.md §12.7, experiments 2 and 3), under
# --odr=strict.
# A lambda's operator() is implicitly constexpr from C++17: not hashed
# (N25), so units of -std=c++14 and c++17 write one hash.
#@ spec: odr.md §3 N25, §12.7
#@ requires: g++

cxx -O0 -std=c++14 a.cc -o a0.o
meta a.meta a0.o -o a.o
cxx -O0 -std=c++17 b.cc -o b0.o
meta b.meta b0.o -o b.o
cxx -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o a.o b.o -o prog
link(mortar) g++ -static -no-pie main.o a.o b.o -Wl,--odr=strict -o prog
run prog
  stdout: 2 2

#--- a.cc
__attribute__((noinline)) inline int g() { auto l = [](int x) { return x + 1; }; return l(1); }
int fa() { return g(); }
