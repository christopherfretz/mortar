definition anchor=_ZZ1gvENKUliE_clEi hash=216dca8080e9097201b41b0b02344f66 class=1 flags=1 file=h.h line=1
#--- b.cc
__attribute__((noinline)) inline int g() { auto l = [](int x) { return x + 1; }; return l(1); }
int fb() { return g(); }
