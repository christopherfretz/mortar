# Model case mixed-std-user-body (spec/odr.md §12.7, experiments 2 and 3), under
# --odr=strict.
# User code whose tokens differ by __cplusplus: the rows are not SYSTEM, so
# the difference stays a finding (O-32, Q6), an error under strict.
#@ spec: odr.md §12.7, "O-32"
#@ requires: g++
#@ diag: odr-violation a.o b.o

cxx -O0 -std=c++17 a.cc -o a0.o
meta a.meta a0.o -o a.o
cxx -O0 -std=c++20 b.cc -o b0.o
meta b.meta b0.o -o b.o
cxx -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o a.o b.o -o prog
link(mortar) g++ -static -no-pie main.o a.o b.o -Wl,--odr=strict -o prog
  exit: fail
  diag: violates the one-definition rule
run(bfd,lld,mold) prog
  stdout: 17 17

#--- a.cc
__attribute__((noinline)) inline int ver() {
#if __cplusplus >= 202002L
  return 20;
#else
  return 17;
#endif
}
int fa() { return ver(); }
