# Model case K4-pointer-only (spec/odr.md §12.7, experiments 2 and 3), under
# --odr=strict.
# S is reached only as a pointee, complete in both units: the revised O-17
# writes its row, whose layouts differ; the kind 2 hashes are equal.
#@ spec: odr.md §12.7, "O-17"
#@ requires: g++
#@ diag: odr-type-mismatch a.o b.o

cxx -O0 a.cc -o a0.o
meta a.meta a0.o -o a.o
cxx -O0 b.cc -o b0.o
meta b.meta b0.o -o b.o
cxx -O0 main.cc -o main.o
link(bfd,lld,mold) g++ -static -no-pie main.o a.o b.o -o prog
link(mortar) g++ -static -no-pie main.o a.o b.o -Wl,--odr=strict -o prog
  exit: fail
  diag: violates the one-definition rule
run(bfd,lld,mold) prog
  stdout: 1 1

#--- a.cc
struct S { int a; int b; };
__attribute__((noinline)) inline int isnull(S* p) { return p == nullptr; }
int fa() { return isnull(nullptr); }
