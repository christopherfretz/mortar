# One class, two translation units compiled by kiln with different -D
# options that do not change its layout (spec/odr.md O-17, O-18, O-19;
# WP-134): a non-virtual member function present in one unit only, an
# inline member function's body and a default argument that depend on
# the macro, a static data member's initializer, and a member's default
# initializer. Kind 3 hashes the layout, kind 4 describes it: neither
# differs. Kind 2 (kiln 3b77b13c7, scheme kiln-odr-1.d4) has a row for
# S::get in both units: its body's tokens are equal (`level` is hashed as
# the entity it names, not its value, O-10), but since K-3e the default
# argument on get's own parameter is hashed (O-10 "Default arguments",
# K8): `k = TRACE` is 1 in a.o and 2 in b.o, so --odr=strict reports
# S::get, a true finding ([dcl.fct.default]), at the level default (and
# at detail: kiln-define-same-layout-detail); under .d3 the argument was a fixed token, the row
# PARTIAL and equal, and strict was silent (WP-199). S::name, in b.o only, is
# compared with nothing. The class itself differs in its tokens (a miss:
# kind 3's definition hash is zero, X22), and no kind 3 finding is made.
# At the default mode (kind 2 is strict's, O-47) mortar links the same
# objects and the program runs: kiln-define-same-layout-silent.
#@ spec: odr.md O-10, O-17, O-19
#@ arch: aarch64 x86_64
#@ requires: kiln g++
#@ diag: odr-violation a.o b.o

cxx(kiln) -O0 -DTRACE=1 -fmason-metadata a.cc -o a.o
cxx(kiln) -O0 -DTRACE=2 -DWITH_NAME -fmason-metadata b.cc -o b.o
cxx(kiln) -O0 main.cc -o main.o
link(mortar) g++ main.o a.o b.o -Wl,--odr=strict -Wl,--odr-stats -o strict
  exit: fail
  diag: ^mortar: error: _ZNK1S3getEi violates the one-definition rule$
  diag: ^mortar: odr-stats: mode strict; units 2, rows * kind 3 *, record findings 1;

#--- s.h
struct S {
  int a = TRACE;
  long b;
  static const int level = TRACE;
  int get(int k = TRACE) const { return a * 0 + k + 10 + level * 0 + 1; }
#ifdef WITH_NAME
  const char* name() const { return "S"; }
#endif
};
struct Base { virtual ~Base() {} virtual int v() const { return TRACE; } int x; };
struct Derived : Base { int v() const override { return TRACE + 1; } S s; };
#--- a.cc
#include "s.h"
int from_a(S* s, Base* b) { return s->get(2) + (b ? b->x : 0); }
#--- b.cc
#include "s.h"
int from_b(S* s, Base* b) {
#ifdef WITH_NAME
  (void)s->name();
#endif
  return s->get(2) + (b ? b->x : 0);
}
#--- main.cc
#include <stdio.h>
struct S;
struct Base;
int from_a(S*, Base*);
int from_b(S*, Base*);
int main() {
  alignas(16) static char buf[64] = {};
  printf("%d %d\n", from_a((S*)buf, nullptr), from_b((S*)buf, nullptr));
  return 0;
}
