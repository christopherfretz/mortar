# GCC `-g3` puts each header's macros in a `.debug_macro` COMDAT group
# (`wm4.<file>.<line>.<md5>`) and each unit imports the group by offset
# (`DW_MACRO_import`, a relocation against the group member's section
# symbol). The copies of b.o and c.o are dropped: their imports are
# filled against the keeper's (a.o's) copy of the same name and size
# (image.md I-47a; GNU ld writes the same, mold keeps every `wm4.*` copy).
# All ones there (I-47, before WP-249) crashed gdb 16 on `info macro`; 0
# (lld) names the output's first macro unit, a.c's, so gdb finds
# WP249_A_ONLY (a.c's own macro) in b.c: lld is skipped. The import fields
# are stated without layout: no import is all ones and readelf decodes
# every unit; that each names the unit GNU ld's names is
# crates/mortar/tests/macro_import.rs (by the units' contents). gdb and
# lldb run host programs only: on x86-64 (qemu) those steps are skipped by
# name; x86-64's gdb answers are macro_import.rs's `gdb_x86_64_macros`.
# The verifier's §5.8 still demands the tombstone there (R1) until WP-250.
#@ spec: image.md I-47a
#@ arch: aarch64 x86_64
#@ requires: gdb lldb
#@ skip(lld): writes 0: gdb and lldb read a.c's macros in b.c (WP-249 §2.3)

cc -O0 -g3 -gdwarf-4 a.c -o a4.o
cc -O0 -g3 -gdwarf-4 b.c -o b4.o
cc -O0 -g3 -gdwarf-4 c.c -o c4.o
cc -O0 -g3 -gdwarf-5 a.c -o a5.o
cc -O0 -g3 -gdwarf-5 b.c -o b5.o
cc -O0 -g3 -gdwarf-5 c.c -o c5.o
link gcc -static a4.o b4.o c4.o -o p4
link gcc -static a5.o b5.o c5.o -o p5
run p4
  stdout: b
  stdout: 48 7 84
run p5
  stdout: b
  stdout: 48 7 84
check readelf --debug-dump=macro p4
  has: DW_MACRO_import - offset : 0x
  not: DW_MACRO_import - offset : 0xffffffff
check readelf --debug-dump=macro p5
  has: DW_MACRO_import - offset : 0x
  not: DW_MACRO_import - offset : 0xffffffff
check gdb p4 "break b_f" run "info macro WP249_ANSWER" "macro expand WP249_TWICE(WP249_ANSWER)" "info macro WP249_A_ONLY" "info macro __GNUC__" kill
  has: ^#define WP249_ANSWER 42$
  has: ^expands to: ((42) \* 2)$
  has: The symbol `WP249_A_ONLY' has no definition
  has: ^-D__GNUC__=
  not: This is a bug
check gdb p5 "break b_f" run "info macro WP249_ANSWER" "macro expand WP249_TWICE(WP249_ANSWER)" "info macro WP249_A_ONLY" "info macro __GNUC__" kill
  has: ^#define WP249_ANSWER 42$
  has: ^expands to: ((42) \* 2)$
  has: The symbol `WP249_A_ONLY' has no definition
  has: ^-D__GNUC__=
  not: This is a bug
check lldb p5 "b b_f" run "expr WP249_TWICE(WP249_ANSWER)" kill
  has: stop reason = breakpoint 1.1
  has: (int) $0 = 84
check lldb p4 "b b_f" run "expr WP249_TWICE(WP249_ANSWER)" kill
  has: stop reason = breakpoint 1.1
  has: (int) $0 = 84

#--- h.h
#ifndef WP249_H
#define WP249_H
#define WP249_ANSWER 42
#define WP249_TWICE(x) ((x) * 2)
struct wp249_point { int x; long y; };
int b_f(int);
int c_f(int);
extern int g_b;
#endif
#--- a.c
#include <stdio.h>
#include "h.h"
#define WP249_A_ONLY 1 /* a macro of a.c only: not defined in b.c */
int main(void) {
  struct wp249_point p = { 1, 2 };
  int r = b_f(p.x) + c_f((int)p.y);
  printf("%d %d %d\n", r, g_b, WP249_TWICE(WP249_ANSWER));
  return 0;
}
#--- b.c
#include <stdio.h>
#include "h.h"
int g_b = 7;
int b_f(int x) {
  struct wp249_point q = { x, WP249_ANSWER };
  puts("b");
  return q.x + (int)q.y;
}
#--- c.c
#include <string.h>
#include "h.h"
int c_f(int x) {
  struct wp249_point q = { WP249_TWICE(x), 3 };
  return q.x + (int)strlen("c");
}
