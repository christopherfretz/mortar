# The real-builds lane's projects (spec/harness.md "realbuild"): the bench
# manifest's format. Each project is fetched from its public home, checked
# by its SHA-256, built by its own build system unpatched by
# tests/realbuild/projects/<name>.sh, and never committed.
#
#   version, url, sha256, root (the directory of the archive), licence,
#   why (one sentence), rows (gcc, clang), extra (<url> <sha256> <root>:
#   a second archive, a test suite shipped apart), tests (which, when not
#   all of them, and why).

[zlib]
version = 1.3.1
url = https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz
sha256 = 9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
root = zlib-1.3.1
licence = Zlib
why = C; its own configure script and Makefile; the default build makes libz.so (with a version script) and libz.a, and links the tests against both: how much of a typical build is -shared
rows = gcc clang

