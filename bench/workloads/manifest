[hello-cxx-static]
class = small
kind = sources
about = The same C++ program linked statically against libstdc++ and glibc.
sources = hello.cc
driver = g++
cflags = -O2
ldflags = -static
run =

# protobuf 3.21.12, the last release without abseil: protoc is main.o and
# the static libprotoc and libprotobuf, some 200 translation units of C++.
[cxx-medium-g]
class = medium
kind = cmake
about = protoc of protobuf 3.21.12 at -O0 -g: a medium C++ program with debug information.
url = https://github.com/protocolbuffers/protobuf/releases/download/v21.12/protobuf-cpp-3.21.12.tar.gz
sha256 = 4eab9b524aa5913c6fffb20b2a8abf5ef7f95a80bc0701f3a6dbb4c607f73460
root = protobuf-3.21.12
options = -DCMAKE_BUILD_TYPE=None -DCMAKE_C_COMPILER=gcc -Dprotobuf_BUILD_TESTS=OFF -Dprotobuf_WITH_ZLIB=OFF -Dprotobuf_BUILD_SHARED_LIBS=OFF
prebuild = libprotobuf libprotoc
target = protoc
driver = g++
cflags = -O0 -g
capture = protoc*
run = -I$S/src --include_imports --descriptor_set_out=/dev/fd/1 $S/src/google/protobuf/unittest.proto

[cxx-medium]
