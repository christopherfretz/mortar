# The bench workloads (spec/harness.md "bench", "Workloads").
#
# One section per workload: how its inputs are rebuilt from pinned sources,
# and which link of the build is the workload. Nothing built is checked in;
# `cargo xtask bench` builds a workload into its cache the first time, and
# again whenever this section, the tools that build it or its sources
# change. AArch64 (the host) only for now.
#
# Keys: class (small, medium, large, extreme, rust, calibration), kind
# (sources, synthetic, cmake, cargo, planned), about (one sentence), and
# per kind: sources; shape and params; url, sha256, root, options,
# prebuild, target; rev, package, bin, rustc_args; needs. driver, cflags,
# ldflags and capture where the kind takes them; run (the arguments the
# linked program is run with, mortar's output against GNU ld's: `run =`
# is no argument, no `run` is no run; `$S` is the source directory).
# Values are words separated by blanks: no quoting.
#
# mortar links static non-PIE executables only until M2: every workload
# linked as PIE or dynamic has a `-static` twin (`<name>-static`) that
# mortar links today. The PIE and dynamic originals stay, as M2's
# workloads: mortar refuses them by name, which does not fail a run.

# The control of every run (spec/harness.md "bench", "Calibration"): not
# reported, not judged.
[calibration]
class = calibration
kind = synthetic
about = The calibration link: a fixed set of generated objects.
shape = objects
params = 100 50
driver = gcc
cflags = -O1

[hello-c]
class = small
kind = sources
about = Hello world in C against glibc, position-independent and dynamic: start-up dominates.
sources = hello.c
driver = gcc
cflags = -O2
ldflags = -pie
run =

[hello-c-static]
class = small
kind = sources
about = Hello world in C, linked statically against glibc's archives.
sources = hello.c
driver = gcc
cflags = -O2
ldflags = -static
run =

[hello-cxx]
class = small
kind = sources
about = Hello world in C++ (iostreams, a map, an exception) against the shared libstdc++.
sources = hello.cc
driver = g++
cflags = -O2
ldflags = -pie
