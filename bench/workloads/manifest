# mortar's own binary as rustc links it (the dev profile: debug
# information, many rlibs), at a pinned commit of this repository so that
# the inputs do not move with every change. Bumped deliberately, with a
# baseline update.
[rust-self]
class = rust
kind = cargo
about = mortar's binary (dev profile) as rustc invokes the linker, at a pinned commit.
rev = 413481782430e79cc8b945965385a10d9b2969a2
package = mortar
bin = mortar
rustc_args = -C save-temps
capture = mortar-*
run = --version

# The same binary with glibc linked statically and a non-PIE executable:
# `crt-static` makes rustc pass `-static` (with `-static-pie` unless the
# relocation model is static).
[rust-self-static]
class = rust
kind = cargo
about = mortar's binary (dev profile) as rustc links it with crt-static, non-PIE.
rev = 413481782430e79cc8b945965385a10d9b2969a2
package = mortar
bin = mortar
rustc_args = -C save-temps -C target-feature=+crt-static -C relocation-model=static
capture = mortar-*
run = --version

